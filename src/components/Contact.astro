---
---

<footer
  class="relative min-h-[92svh] md:min-h-[96svh] w-full bg-ink text-paper px-6 sm:px-10 md:px-14 lg:px-20 pt-16 md:pt-24 pb-10 md:pb-12 flex flex-col justify-between overflow-hidden"
  id="kontak"
>
  <div class="relative z-10 w-full my-auto">
    <div class="relative w-full flex flex-col lg:flex-row lg:items-end justify-between gap-8">
      <div class="w-full">
        <h2
          class="font-condensed-tight text-[clamp(4.1rem,14.5vw,16.2rem)] leading-[0.86] uppercase tracking-tighter text-zinc-100 select-none"
        >
          <span
            class="block"
            data-motion="fade-right"
            data-scroll-speed="-0.06"
            data-scroll-x="-0.04"
          >
            LET'S
          </span>
          <span
            class="block -mt-1 md:-mt-3"
            data-motion="fade-left"
            data-scroll-speed="-0.04"
            data-scroll-x="0.04"
          >
            COLLABORATE.
          </span>
        </h2>
      </div>

      <div
        class="lg:absolute lg:right-4 xl:right-12 lg:bottom-2 self-start lg:self-auto pointer-events-none select-none"
        aria-hidden="true"
      >
        <svg
          class="w-28 h-24 sm:w-36 sm:h-28 md:w-44 md:h-36 text-zinc-300 overflow-visible"
          viewBox="0 0 160 120"
          fill="none"
        >
          <g class="contact-accent-envelope" style="transform-origin: 96px 46px;">
            <g class="envelope-float-inner">
              <rect
                x="58"
                y="18"
                width="76"
                height="52"
                rx="4"
                stroke="currentColor"
                stroke-width="2"
              />
              <polyline
                points="60,21 96,49 132,21"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </g>
          </g>

          <g class="contact-cue-group text-zinc-400">
            <path
              class="contact-cue-line"
              d="M 68 78 Q 44 94 16 102"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              fill="none"
            />
            <polyline
              class="contact-cue-head"
              points="25,94 14,102 27,106"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"
            />
          </g>
        </svg>
      </div>
    </div>

    <div class="mt-10 md:mt-14 space-y-8 md:space-y-10 max-w-3xl">
      <p
        class="text-sm sm:text-base md:text-lg text-zinc-400 leading-relaxed"
        data-motion="up"
        data-i18n-html="contact.desc"
      >
        Produk digital<br />
        dan karya visual.
      </p>

      <div data-motion="up">
        <a
          id="contact-email-cta"
          href="mailto:renakunx@gmail.com"
          class="inline-block font-editorial-heading text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-100 hover:text-white transition-colors underline decoration-zinc-700 hover:decoration-zinc-200 decoration-2 underline-offset-8"
        >
          renakunx@gmail.com
        </a>
      </div>

      <div
        class="pt-2 space-y-2.5 text-xs sm:text-sm md:text-base font-mono text-zinc-400"
        data-motion="up"
      >
        <div class="text-zinc-300 font-medium pb-1" data-i18n="contact.role">
          Junior Application Developer · Graphic Designer
        </div>
        <div>
          <span class="text-zinc-500">GitHub — </span>
          <a
            href="https://github.com/Zahrean001"
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-200 hover:text-white transition-colors underline decoration-zinc-700 hover:decoration-zinc-300 underline-offset-4"
          >
            github.com/Zahrean001
          </a>
        </div>
        <div>
          <span class="text-zinc-500" data-i18n-html="contact.cvLabel">CV — &nbsp;</span>
          <a
            href="/resume.pdf"
            download="CV_Muhammad_Azhar_Nur_Azmi_Zahrein.pdf"
            class="text-zinc-200 hover:text-white transition-colors underline decoration-zinc-700 hover:decoration-zinc-300 underline-offset-4"
            data-i18n="contact.cvDownload"
          >
            Unduh CV
          </a>
        </div>
      </div>
    </div>
  </div>

  <div
    class="relative z-10 w-full mt-14 pt-5 md:pt-6 border-t border-zinc-800/90 flex justify-between items-center text-[11px] sm:text-xs font-mono text-zinc-500"
  >
    <span>Muhammad Azhar Nur Azmi Zahrein, A.Md.Kom.</span>
    <span data-i18n="contact.footerSchool">D3 Teknik Informatika, PENS</span>
  </div>
</footer>
