---
import type { OptimizedAsset } from './ProjectSijagung.astro';

interface Props {
  pensLogo: OptimizedAsset;
}

const { pensLogo } = Astro.props;
---

<!-- Education & Certifications Section -->
<section
  class="relative pt-16 md:pt-24 pb-16 md:pb-24 px-6 sm:px-10 md:px-14 lg:px-20 border-b border-paper-line overflow-hidden"
  id="pendidikan"
>
  <div
    class="bg-watermark-wrap top-1/2 -translate-y-1/2"
    data-watermark
    data-watermark-speed="0.2"
    aria-hidden="true"
  >
    <div class="bg-watermark-text">EDUCATION</div>
  </div>

  <div
    class="relative z-10 w-full max-w-4xl mx-auto flex flex-col md:flex-row md:items-start justify-between gap-8 md:gap-12"
  >
    <div class="space-y-8 flex-1">
      <div class="space-y-2 border-b border-paper-line pb-4">
        <div class="text-xs font-mono uppercase tracking-widest text-zinc-500" data-i18n="edu.eyebrow">
          04 / Kualifikasi Akademik & Kredensial Resmi
        </div>
        <h2
          class="font-editorial-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-ink leading-tight"
          data-motion="up"
          data-scroll-speed="-0.06"
          data-i18n="edu.heading"
          style="--m-delay: 0ms;"
        >
          Pendidikan & Sertifikasi
        </h2>
      </div>

      <!-- Education Items (Clean Editorial List) -->
      <div class="space-y-6 pt-1">
        <!-- PENS -->
        <div class="space-y-1 pl-4 border-l-2 border-ink" data-motion="fade-right" style="--m-delay: 80ms;">
          <div class="flex items-center justify-between flex-wrap gap-1">
            <h3 class="text-lg sm:text-xl md:text-2xl font-semibold text-ink" data-i18n="edu.pensTitle">
              Politeknik Elektronika Negeri Surabaya (PENS)
            </h3>
            <span class="text-xs font-mono text-zinc-500 font-semibold" data-i18n="edu.pensTimeline">
              2023 – 2026
            </span>
          </div>
          <p class="text-sm sm:text-base text-zinc-700 font-mono" data-i18n="edu.pensDegree">
            Associate Degree (D3) Teknik Informatika · A.Md.Kom.
          </p>
          <p class="text-xs text-zinc-500 font-mono" data-i18n="edu.pensPeriod">
            2023 – 2026
          </p>
        </div>

        <!-- SMKN 2 Tanjung Selor -->
        <div class="space-y-1 pl-4 border-l-2 border-zinc-400" data-motion="fade-right" style="--m-delay: 130ms;">
          <div class="flex items-center justify-between flex-wrap gap-1">
            <h3 class="text-base sm:text-lg md:text-xl font-semibold text-ink" data-i18n="edu.smknTitle">
              SMK Negeri 2 Tanjung Selor
            </h3>
            <span class="text-xs font-mono text-zinc-500" data-i18n="edu.smknTimeline">
              2020 – 2023 · Lulus
            </span>
          </div>
          <p class="text-xs sm:text-sm text-zinc-700 font-mono" data-i18n="edu.smknDegree">
            Kompetensi Keahlian Rekayasa Multimedia
          </p>
        </div>
      </div>

      <!-- Verified Certifications (Tabular Specifications) -->
      <div class="space-y-3 pt-6 border-t border-paper-line" data-motion="up" style="--m-delay: 170ms;">
        <div class="text-xs font-mono uppercase tracking-widest text-zinc-500 font-bold" data-i18n="edu.certHeading">
          Sertifikasi Terverifikasi:
        </div>

        <dl class="divide-y divide-paper-line border-t border-b border-paper-line text-xs font-mono">
          <div class="py-3 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1">
            <dt class="font-semibold text-ink" data-i18n="edu.certAws">
              AWS Academy Graduate — AWS Academy Cloud Developing
            </dt>
            <dd class="text-zinc-500 sm:text-right" data-i18n="edu.certAwsIssuer">Amazon Web Services · Verified</dd>
          </div>
          <div class="py-3 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1">
            <dt class="font-semibold text-ink" data-i18n="edu.certToefl">
              TOEFL (Test of English as a Foreign Language) — Skor: 483
            </dt>
            <dd class="text-zinc-500 sm:text-right" data-i18n="edu.certToeflIssuer">High Intermediate Proficiency · Verified</dd>
          </div>
        </dl>
      </div>
    </div>

    <div
      class="flex-shrink-0 self-center md:self-start pt-4 md:pt-12"
      data-motion="slide-right-3d"
      data-scroll-speed="0.1"
      data-scroll-x="0.06"
      data-scroll-rot="-2.2"
      style="--m-delay: 90ms;"
    >
      <img
        alt="Logo 3D Politeknik Elektronika Negeri Surabaya (PENS)"
        class="logo-3d-emblem w-44 sm:w-52 md:w-60 lg:w-64 h-auto object-contain select-none"
        width={pensLogo.width}
        height={pensLogo.height}
        loading="eager"
        decoding="async"
        src={pensLogo.src}
      />
    </div>
  </div>
</section>
