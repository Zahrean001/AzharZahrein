---
import type { OptimizedAsset } from './ProjectSijagung.astro';

interface Props {
  pknLogo: OptimizedAsset;
}

const { pknLogo } = Astro.props;
---

<!-- Experience Section -->
<section
  class="relative pt-16 md:pt-24 pb-16 md:pb-20 px-6 sm:px-10 md:px-14 lg:px-20 border-b border-paper-line overflow-hidden"
  id="pengalaman"
>
  <div
    class="bg-watermark-wrap top-1/2 -translate-y-1/2"
    data-watermark
    data-watermark-speed="0.2"
    aria-hidden="true"
  >
    <div class="bg-watermark-text">EXPERIENCE</div>
  </div>

  <div
    class="relative z-10 w-full max-w-4xl mx-auto flex flex-col md:flex-row md:items-start justify-between gap-8 md:gap-12"
  >
    <div class="space-y-6 flex-1">
      <div class="space-y-2 border-b border-paper-line pb-4">
        <div class="text-xs font-mono uppercase tracking-widest text-zinc-500" data-i18n="exp.eyebrow">
          02 / Riwayat Profesional & Kemitraan CSR
        </div>
        <h2
          class="font-editorial-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-ink leading-tight"
          data-motion="up"
          data-scroll-speed="-0.06"
          data-i18n="exp.heading"
          style="--m-delay: 0ms;"
        >
          Pengalaman
        </h2>
      </div>

      <div class="space-y-6 pt-1">
        <div class="space-y-1">
          <h3
            class="text-xl sm:text-2xl md:text-3xl font-semibold text-ink"
            data-motion="fade-right"
            data-i18n="exp.company"
            style="--m-delay: 80ms;"
          >
            PT Pesona Khatulistiwa Nusantara (ENM Group)
          </h3>
          <div
            class="text-xs sm:text-sm font-mono text-zinc-700 font-semibold"
            data-motion="up"
            data-i18n="exp.program"
            style="--m-delay: 110ms;"
          >
            Penerima Beasiswa Prestasi & Pelaksana Proyek IT / Desain
          </div>
          <div
            class="text-xs font-mono text-zinc-500"
            data-motion="up"
            data-i18n="exp.period"
            style="--m-delay: 130ms;"
          >
            2023 – 2026 (Berkala & Terstruktur)
          </div>
        </div>

        <!-- Structured Timeline (Hairline Dividers, Zero Card Slop) -->
        <div class="space-y-6 pt-2" data-motion="up" style="--m-delay: 160ms;">
          <div class="space-y-1.5 pl-4 border-l-2 border-ink">
            <div class="font-mono text-xs font-bold uppercase tracking-wider text-ink" data-i18n="exp.track1Title">
              Pengembangan Aplikasi & Dukungan IT
            </div>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed" data-i18n="exp.track1Desc">
              Merancang dan membangun aplikasi mobile SIJAGUNG untuk digitalisasi pencatatan data pertanian jagung di Desa Kelubir. Membantu operasional pemeliharaan sistem TI kantor, manajemen basis data, dan penanganan kendala teknis perangkat keras/lunak.
            </p>
          </div>

          <div class="space-y-1.5 pl-4 border-l-2 border-zinc-400">
            <div class="font-mono text-xs font-bold uppercase tracking-wider text-ink" data-i18n="exp.track2Title">
              Desain Kemasan & Identitas Visual UMKM
            </div>
            <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed" data-i18n="exp.track2Desc">
              Merancang identitas merek, desain kemasan standing pouch komersial siap cetak, dan materi promosi visual untuk UMKM mitra binaan Program Pengembangan Masyarakat (CSR/PPM) PT PKN.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div
      class="flex-shrink-0 self-center md:self-start pt-4 md:pt-12"
      data-motion="slide-right-3d"
      data-scroll-speed="0.1"
      data-scroll-x="0.06"
      data-scroll-rot="2.2"
      style="--m-delay: 90ms;"
    >
      <img
        alt="Logo 3D PT Pesona Khatulistiwa Nusantara"
        class="logo-3d-emblem w-48 sm:w-56 md:w-64 lg:w-72 h-auto object-contain select-none"
        width={pknLogo.width}
        height={pknLogo.height}
        loading="eager"
        decoding="async"
        src={pknLogo.src}
      />
    </div>
  </div>
</section>
