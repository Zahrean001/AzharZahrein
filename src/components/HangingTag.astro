---
---

<div
  id="hero-hanging-container"
  class="hero-hanging-container pointer-events-none select-none"
  aria-label="Inspirational quote badge: STILL CHASING MY DREAM"
>
  <!-- Dynamic SVG for the dual-cable triangular elastic suspension -->
  <svg
    id="hero-rope-svg"
    class="hero-rope-svg pointer-events-none overflow-visible"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="cord-line-grad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="rgba(212, 212, 216, 0.25)" />
        <stop offset="35%" stop-color="rgba(228, 228, 231, 0.7)" />
        <stop offset="80%" stop-color="rgba(244, 244, 245, 0.95)" />
        <stop offset="100%" stop-color="#ffffff" />
      </linearGradient>
      <linearGradient id="cord-glow-grad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="rgba(16, 185, 129, 0.05)" />
        <stop offset="60%" stop-color="rgba(16, 185, 129, 0.35)" />
        <stop offset="100%" stop-color="rgba(52, 211, 153, 0.85)" />
      </linearGradient>
      <filter id="rope-filter-glow" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="2.5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- Left Cable: Shadow, Glow, Core -->
    <path
      id="rope-left-shadow"
      fill="none"
      stroke="rgba(0, 0, 0, 0.55)"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      id="rope-left-glow"
      fill="none"
      stroke="url(#cord-glow-grad)"
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.6"
    />
    <path
      id="rope-left-core"
      fill="none"
      stroke="url(#cord-line-grad)"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Right Cable: Shadow, Glow, Core -->
    <path
      id="rope-right-shadow"
      fill="none"
      stroke="rgba(0, 0, 0, 0.55)"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      id="rope-right-glow"
      fill="none"
      stroke="url(#cord-glow-grad)"
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.6"
    />
    <path
      id="rope-right-core"
      fill="none"
      stroke="url(#cord-line-grad)"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Apex Attachment Rings (Where Left & Right Cords Meet at the Tag) -->
    <circle
      id="rope-left-ring"
      cx="0"
      cy="0"
      r="4.5"
      fill="#18181b"
      stroke="#e4e4e7"
      stroke-width="1.8"
    />
    <circle
      id="rope-right-ring"
      cx="0"
      cy="0"
      r="4.5"
      fill="#18181b"
      stroke="#e4e4e7"
      stroke-width="1.8"
    />
    <circle
      id="rope-apex-ring"
      cx="0"
      cy="0"
      r="6"
      fill="#18181b"
      stroke="#34d399"
      stroke-width="2"
      filter="drop-shadow(0 2px 4px rgba(0,0,0,0.6))"
    />
    <circle
      id="rope-apex-pin"
      cx="0"
      cy="0"
      r="2.2"
      fill="#34d399"
    />
  </svg>

  <!-- The Hanging Card / Tag Badge (Suspended by the triangular dual cords) -->
  <div
    class="hanging-tag-card group cursor-grab active:cursor-grabbing pointer-events-auto"
    id="hero-tag-card"
    role="button"
    tabindex="0"
    aria-label="STILL CHASING MY DREAM"
  >
    <!-- Top Attachment Bracket (Dual-Anchor Apex Mount) -->
    <div class="hanging-tag-bracket" aria-hidden="true">
      <div class="hanging-tag-bracket-ring-anchor left-anchor"></div>
      <div class="hanging-tag-bracket-hole">
        <div class="hanging-tag-bracket-pin"></div>
      </div>
      <div class="hanging-tag-bracket-ring-anchor right-anchor"></div>
    </div>

    <!-- Card Body: Sleek dark editorial badge with border glow -->
    <div class="hanging-tag-inner">
      <!-- Live pulse indicator dot -->
      <span class="relative flex h-3.5 w-3.5 mr-3 sm:mr-3.5 flex-shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.95)]"></span>
      </span>

      <!-- Quote Text -->
      <span class="hanging-tag-text font-mono font-bold tracking-[0.2em] uppercase text-zinc-100 text-[14px] sm:text-[16px] md:text-[18px] whitespace-nowrap">
        STILL CHASING MY DREAM
      </span>

      <!-- Micro Tech Glyph / Star -->
      <span class="ml-3 sm:ml-3.5 text-zinc-500 group-hover:text-emerald-400 text-sm sm:text-base md:text-lg transition-colors" aria-hidden="true">
        ✦
      </span>
    </div>

    <!-- Interactive Hint Tooltip -->
    <span
      class="hanging-tag-hint font-mono text-[10px] sm:text-[11px] uppercase tracking-wider text-zinc-300"
      data-i18n="hero.hangingHint"
    >
      Click & drag to swing
    </span>
  </div>
</div>

<style>
  .hero-hanging-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 50;
    overflow: visible;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .hero-hanging-container.is-ready {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-rope-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }

  /* Card Tag */
  .hanging-tag-card {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: 50% 0px;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    z-index: 2;
    will-change: transform;
  }

  .hanging-tag-bracket {
    width: 32px;
    height: 12px;
    background: #27272a;
    border: 1.5px solid #71717a;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 4px;
    z-index: 1;
    position: relative;
  }

  .hanging-tag-bracket-hole {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: #09090b;
    border: 0.5px solid #52525b;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hanging-tag-bracket-pin {
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    background: #34d399;
  }

  .hanging-tag-bracket-ring-anchor {
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: #71717a;
  }

  .hanging-tag-inner {
    display: inline-flex;
    align-items: center;
    padding: 12px 26px;
    background: rgba(10, 10, 13, 0.96);
    border: 2px solid rgba(161, 161, 170, 0.65);
    border-radius: 10px;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow:
      0 20px 48px -4px rgba(0, 0, 0, 0.95),
      0 0 20px rgba(16, 185, 129, 0.12),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }

  @media (min-width: 640px) {
    .hanging-tag-inner {
      padding: 14px 32px;
    }
  }

  @media (min-width: 1024px) {
    .hanging-tag-inner {
      padding: 16px 38px;
    }
  }

  .hanging-tag-card:hover .hanging-tag-inner {
    border-color: rgba(16, 185, 129, 0.85);
    box-shadow:
      0 24px 54px -4px rgba(0, 0, 0, 0.98),
      0 0 28px rgba(16, 185, 129, 0.4),
      0 0 0 1px rgba(16, 185, 129, 0.3) inset;
  }

  .hanging-tag-hint {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
    background: rgba(18, 18, 22, 0.95);
    padding: 5px 12px;
    border-radius: 6px;
    border: 1px solid #52525b;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.8);
  }

  .hanging-tag-card:hover .hanging-tag-hint {
    opacity: 1;
    transform: translateX(-50%) translateY(2px);
  }

  /* Active Dragging State */
  .hanging-tag-card.is-dragging {
    cursor: grabbing;
  }

  .hanging-tag-card.is-dragging .hanging-tag-inner {
    border-color: #10b981;
    background: rgba(14, 14, 18, 0.98);
    box-shadow:
      0 28px 60px rgba(0, 0, 0, 1),
      0 0 36px rgba(16, 185, 129, 0.65);
  }

  .hanging-tag-card.is-dragging .hanging-tag-hint {
    opacity: 0 !important;
  }
</style>
