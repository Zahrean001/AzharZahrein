---
---

<div
  id="hero-hanging-container"
  class="hero-hanging-container pointer-events-none select-none"
  aria-label="Inspirational quote badge: STILL CHASING MY DREAM"
>
  <!-- Dynamic SVG for the dual-cable triangular elastic suspension -->
  <svg
    id="hero-rope-svg"
    class="hero-rope-svg pointer-events-none overflow-visible"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="cord-line-grad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="rgba(161, 161, 170, 0.3)" />
        <stop offset="40%" stop-color="rgba(212, 212, 216, 0.85)" />
        <stop offset="100%" stop-color="#ffffff" />
      </linearGradient>
      <linearGradient id="cord-glow-grad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="rgba(255, 255, 255, 0.05)" />
        <stop offset="70%" stop-color="rgba(255, 255, 255, 0.2)" />
        <stop offset="100%" stop-color="rgba(255, 255, 255, 0.4)" />
      </linearGradient>
    </defs>

    <!-- Left Cable: Shadow, Glow, Core -->
    <path
      id="rope-left-shadow"
      fill="none"
      stroke="rgba(0, 0, 0, 0.75)"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      id="rope-left-glow"
      fill="none"
      stroke="url(#cord-glow-grad)"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.4"
    />
    <path
      id="rope-left-core"
      fill="none"
      stroke="url(#cord-line-grad)"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Right Cable: Shadow, Glow, Core -->
    <path
      id="rope-right-shadow"
      fill="none"
      stroke="rgba(0, 0, 0, 0.75)"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      id="rope-right-glow"
      fill="none"
      stroke="url(#cord-glow-grad)"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.4"
    />
    <path
      id="rope-right-core"
      fill="none"
      stroke="url(#cord-line-grad)"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Apex Attachment Rings (Where Left & Right Cords Meet at the Tag) -->
    <circle
      id="rope-left-ring"
      cx="0"
      cy="0"
      r="4"
      fill="#18181b"
      stroke="#71717a"
      stroke-width="1.5"
    />
    <circle
      id="rope-right-ring"
      cx="0"
      cy="0"
      r="4"
      fill="#18181b"
      stroke="#71717a"
      stroke-width="1.5"
    />
    <circle
      id="rope-apex-ring"
      cx="0"
      cy="0"
      r="5"
      fill="#18181b"
      stroke="#a1a1aa"
      stroke-width="1.8"
      filter="drop-shadow(0 2px 4px rgba(0,0,0,0.8))"
    />
    <circle
      id="rope-apex-pin"
      cx="0"
      cy="0"
      r="1.8"
      fill="#e4e4e7"
    />
  </svg>

  <!-- The Hanging Card / Tag Badge (Suspended by the triangular dual cords) -->
  <div
    class="hanging-tag-card group cursor-grab active:cursor-grabbing pointer-events-auto"
    id="hero-tag-card"
    role="button"
    tabindex="0"
    aria-label="STILL CHASING MY DREAM"
    style="transform: translate3d(-50%, -650px, 0);"
  >
    <!-- Top Attachment Bracket (Dual-Anchor Apex Mount) -->
    <div class="hanging-tag-bracket" aria-hidden="true">
      <div class="hanging-tag-bracket-ring-anchor left-anchor"></div>
      <div class="hanging-tag-bracket-hole">
        <div class="hanging-tag-bracket-pin"></div>
      </div>
      <div class="hanging-tag-bracket-ring-anchor right-anchor"></div>
    </div>

    <!-- Card Body: Architectural Monograph Badge (Zero Neon, Clean Monochrome) -->
    <div class="hanging-tag-inner">
      <span class="w-1.5 h-1.5 bg-zinc-400 group-hover:bg-white transition-colors mr-2.5 sm:mr-3 shrink-0"></span>

      <!-- Quote Text -->
      <span class="hanging-tag-text font-mono font-bold tracking-[0.14em] uppercase text-zinc-100 text-[10px] sm:text-[12px] md:text-[13.5px] whitespace-nowrap">
        STILL CHASING MY DREAM
      </span>

      <!-- Monospace Index -->
      <span class="ml-2.5 sm:ml-3 text-zinc-500 group-hover:text-zinc-300 font-mono text-[9px] sm:text-[10px] transition-colors" aria-hidden="true">
        /26
      </span>
    </div>

    <!-- Interactive Hint Tooltip -->
    <span
      class="hanging-tag-hint font-mono text-[9px] uppercase tracking-wider text-zinc-400"
      data-i18n="hero.hangingHint"
    >
      Tarik untuk mengayun
    </span>
  </div>
</div>

<style>
  .hero-hanging-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    z-index: 40;
    pointer-events: none;
  }

  .hero-rope-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 25;
  }

  .hanging-tag-card {
    position: absolute;
    left: 0;
    top: 0;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    transform-origin: center top;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    cursor: grab;
    z-index: 30;
    will-change: transform;
  }

  .hanging-tag-bracket {
    width: 22px;
    height: 8px;
    background: #18181b;
    border: 1px solid #52525b;
    border-bottom: none;
    border-radius: 2px 2px 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 3px;
    z-index: 1;
    position: relative;
    transition: width 0.2s ease, height 0.2s ease;
  }

  @media (min-width: 640px) {
    .hanging-tag-bracket {
      width: 28px;
      height: 10px;
      padding: 0 4px;
    }
  }

  .hanging-tag-bracket-hole {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #09090b;
    border: 0.5px solid #71717a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hanging-tag-bracket-pin {
    width: 2px;
    height: 2px;
    border-radius: 9999px;
    background: #e4e4e7;
  }

  .hanging-tag-bracket-ring-anchor {
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    background: #71717a;
  }

  .hanging-tag-inner {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    background: #09090b;
    border: 1px solid #3f3f46;
    border-radius: 2px;
    box-shadow:
      0 12px 28px -4px rgba(0, 0, 0, 0.95),
      0 0 0 1px rgba(255, 255, 255, 0.06) inset;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  @media (min-width: 640px) {
    .hanging-tag-inner {
      padding: 8px 18px;
    }
  }

  @media (min-width: 1024px) {
    .hanging-tag-inner {
      padding: 10px 24px;
    }
  }

  .hanging-tag-card:hover .hanging-tag-inner {
    border-color: #a1a1aa;
    box-shadow:
      0 16px 36px -4px rgba(0, 0, 0, 0.98),
      0 0 0 1px rgba(255, 255, 255, 0.12) inset;
  }

  .hanging-tag-hint {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
    background: #18181b;
    padding: 3px 8px;
    border: 1px solid #3f3f46;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.8);
  }

  .hanging-tag-card:hover .hanging-tag-hint {
    opacity: 1;
    transform: translateX(-50%) translateY(2px);
  }

  /* Active Dragging State */
  .hanging-tag-card.is-dragging {
    cursor: grabbing;
  }

  .hanging-tag-card.is-dragging .hanging-tag-inner {
    border-color: #ffffff;
    background: #121215;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 1);
  }

  .hanging-tag-card.is-dragging .hanging-tag-hint {
    opacity: 0 !important;
  }
</style>
