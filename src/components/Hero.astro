---
import { navItems } from '../data/portfolio';
import HangingTag from './HangingTag.astro';

interface Props {
  portraitSrc: string;
  portraitWidth: number | string;
  portraitHeight: number | string;
}

const { portraitSrc, portraitWidth, portraitHeight } = Astro.props;
---

<header
  class="relative min-h-[100svh] w-full bg-ink text-paper px-6 sm:px-10 md:px-14 lg:px-20 pt-7 md:pt-10 pb-8 md:pb-10 flex flex-col justify-between overflow-hidden"
  id="cover"
>
  <div class="w-full flex items-start justify-between z-20" data-motion="fade-left" style="--m-delay: 80ms;">
    <!-- Language Switcher - Clean Architectural Monospace -->
    <div
      class="inline-flex items-center border border-zinc-800 bg-zinc-950 p-0.5 text-[11px] font-mono select-none"
      id="lang-switcher"
      role="group"
      aria-label="Language selection"
    >
      <button
        type="button"
        data-lang-btn="id"
        class="px-2.5 py-0.5 transition-colors text-zinc-400 hover:text-white focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white"
        aria-pressed="false"
      >
        ID
      </button>
      <span class="text-zinc-700">/</span>
      <button
        type="button"
        data-lang-btn="en"
        class="px-2.5 py-0.5 transition-colors text-zinc-400 hover:text-white focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white"
        aria-pressed="false"
      >
        EN
      </button>
    </div>

    <!-- Mobile Navigation links (Header only on mobile screens) -->
    <nav
      class="flex md:hidden flex-col items-end space-y-1 text-xs font-editorial-heading tracking-wider uppercase font-semibold text-zinc-400"
      aria-label="Mobile main navigation"
    >
      {
        navItems.map((item) => (
          <a
            class="hover:text-white transition-all duration-150 py-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white"
            href={item.href}
            data-i18n={item.i18nKey}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="relative my-auto py-4 md:py-6 w-full flex items-center">
    <div class="relative w-full">
      <div class="relative z-0 select-none pointer-events-none">
        <h1
          class="font-condensed-tight text-[clamp(6.8rem,22vw,23rem)] leading-[0.85] uppercase tracking-tighter text-zinc-200 pointer-events-none"
          data-motion="fade-right"
          data-scroll-speed="-0.18"
          data-scroll-x="-0.08"
          style="--m-delay: 0ms;"
        >
          PORT
        </h1>
        <h1
          class="font-condensed-tight text-[clamp(6.8rem,22vw,23rem)] leading-[0.85] uppercase tracking-tighter text-zinc-200 -mt-2 md:-mt-4 pointer-events-none"
          data-motion="fade-left"
          data-scroll-speed="-0.1"
          data-scroll-x="0.08"
          style="--m-delay: 90ms;"
        >
          FOLIO.
        </h1>
      </div>

      <div
        class="absolute right-0 sm:right-4 md:right-8 lg:right-12 bottom-0 w-[245px] sm:w-[350px] md:w-[450px] lg:w-[540px] xl:w-[600px] z-30 pointer-events-none transform -rotate-2 origin-bottom-right"
        id="hero-portrait-wrap"
      >
        <!-- Soft Floating Wrapper for the Figure & Hanging Quote -->
        <div class="hero-floating-figure-wrapper" id="hero-floating-figure">
          <img
            alt="Portrait of Muhammad Azhar Nur Azmi Zahrein"
            class="w-full h-auto object-contain filter contrast-105 drop-shadow-[0_20px_35px_rgba(0,0,0,0.9)]"
            data-motion="pop"
            data-scroll-speed="0.16"
            data-scroll-rot="2.5"
            style="--m-delay: 140ms;"
            width={portraitWidth}
            height={portraitHeight}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            src={portraitSrc}
          />

          <!-- Animated Hanging Tag with Flexible Elastic Rope above Head -->
          <HangingTag />
        </div>
      </div>
    </div>
  </div>

  <div
    class="w-full z-20 pt-6 border-t border-zinc-800"
    data-motion="up"
    style="--m-delay: 180ms;"
  >
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div class="space-y-2 pr-4 max-w-2xl">
        <div class="flex items-baseline flex-wrap gap-x-3">
          <h2 class="text-base sm:text-lg md:text-2xl font-semibold tracking-normal text-zinc-100">
            Muhammad Azhar Nur Azmi Zahrein,{' '}
            <span class="font-normal text-zinc-400 text-xs sm:text-sm md:text-base font-mono">A.Md.Kom.</span>
          </h2>
          <span class="text-xs text-zinc-500 font-mono" data-i18n="hero.degree">
            D3 Teknik Informatika, PENS
          </span>
        </div>
        <div class="text-sm sm:text-base md:text-lg font-mono font-medium text-zinc-200 tracking-wide" data-i18n="hero.role">
          Web & Mobile Application Developer · UI/UX & Graphic Designer
        </div>
        <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed max-w-xl" data-i18n="hero.supporting">
          Menggabungkan rekayasa perangkat lunak dengan desain antarmuka yang berpusat pada pengguna dan komunikasi visual.
        </p>
      </div>

      <!-- Architectural Swiss Action Buttons (Zero Bubble/Pill Slop) -->
      <div class="flex items-center flex-wrap gap-3">
        <a
          href="#karya"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-paper text-ink font-mono text-xs font-semibold tracking-wider uppercase hover:bg-white transition-colors"
        >
          <span data-i18n="hero.ctaProjects">Lihat Proyek</span>
          <span aria-hidden="true">↓</span>
        </a>
        <a
          href="/resume.pdf"
          download="Resume EN.pdf"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-transparent text-zinc-300 font-mono text-xs font-medium tracking-wider uppercase border border-zinc-700 hover:border-zinc-300 hover:text-white transition-colors"
        >
          <span data-i18n="hero.ctaResume">Unduh Resume</span>
        </a>
        <a
          href="#kontak"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-transparent text-zinc-400 font-mono text-xs font-medium tracking-wider uppercase border border-zinc-800 hover:border-zinc-500 hover:text-zinc-200 transition-colors"
        >
          <span data-i18n="hero.ctaContact">Kontak</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  @keyframes softFigureFloat {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-9px) rotate(0.6deg);
    }
  }

  .hero-floating-figure-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    animation: softFigureFloat 5.6s ease-in-out infinite;
    will-change: transform;
    transform-origin: center bottom;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-floating-figure-wrapper {
      animation: none !important;
    }
  }
</style>
