---
import type { OptimizedAsset } from './ProjectSijagung.astro';

export interface PackagingPouchItem {
  id: string;
  title: string;
  tiltAngle: string;
  context: string;
  descKey: 'kemasan.item1Desc' | 'kemasan.item2Desc' | 'kemasan.item3Desc';
  front: OptimizedAsset;
  back: OptimizedAsset;
}

interface Props {
  pouches: PackagingPouchItem[];
}

const { pouches } = Astro.props;
---

<section
  class="relative pt-12 md:pt-16 pb-16 md:pb-24 px-6 sm:px-10 md:px-14 lg:px-20 border-b border-paper-line"
  id="kemasan"
>
  <div
    class="bg-watermark-rail"
    data-watermark
    data-watermark-speed="0.06"
    aria-hidden="true"
  >
    <div class="bg-watermark-sticky">
      <div class="bg-watermark-text">PACKAGING</div>
    </div>
  </div>

  <div class="relative z-10 w-full max-w-4xl mx-auto">
    <!-- Header -->
    <div class="space-y-3 mb-12 md:mb-16">
      <div class="text-xs font-mono uppercase tracking-widest text-zinc-500" data-i18n="kemasan.eyebrow">
        Desain Kemasan Komersial Ritel · Program CSR PT PKN
      </div>

      <h2
        class="font-editorial-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-ink leading-tight"
        data-motion="up"
        data-scroll-speed="-0.05"
        data-i18n="kemasan.heading"
      >
        Desain Kemasan Komersial UMKM
      </h2>
      <p
        class="text-sm sm:text-base md:text-lg text-zinc-700 font-normal max-w-2xl"
        data-motion="up"
        data-scroll-speed="-0.03"
        data-i18n="kemasan.desc"
      >
        Tiga desain standing pouch untuk produk makanan UMKM mitra binaan CSR PT Pesona Khatulistiwa Nusantara, memadukan daya pikat visual ritel dengan kepatuhan regulasi legalitas.
      </p>

      <div class="text-xs font-mono text-zinc-500 pt-1">
        <span data-i18n="kemasan.flipHint">Klik atau geser kemasan untuk membalik (Tampak Depan / Belakang)</span>
      </div>
    </div>

    <!-- Pouch Showcase Items -->
    <div class="space-y-20 md:space-y-28">
      {
        pouches.map((pouch, index) => (
          <article class="space-y-6" data-pouch-stage>
            <div class="text-center space-y-1.5" data-motion="up" style="--m-delay: 0ms;">
              <span class="text-xs font-mono text-zinc-500 uppercase tracking-widest">
                {pouch.context}
              </span>
              <h3 class="text-2xl md:text-3xl font-editorial-heading font-bold tracking-tight text-ink">
                {pouch.title}
              </h3>
              <p
                class="text-xs sm:text-sm text-zinc-600 max-w-xl mx-auto leading-relaxed"
                data-i18n={pouch.descKey}
              >
                {index === 0 && 'Mbah Momon Tiwul — Makanan pokok instan olahan singkong tradisional. Konsep desain memadukan tipografi Nusantara modern dengan palet warna bersahaja dan jendela transparan produk.'}
                {index === 1 && 'Onde-Onde Mini — Kudapan renyah berbentuk bulat mini. Pendekatan visual dinamis dengan appetite appeal tinggi untuk menarik minat konsumen ritel dan oleh-oleh daerah.'}
                {index === 2 && 'Surti Snack Keriuk Tempe — Keripik tempe renyah bumbu rempah. Penataan tipografi kontras tinggi untuk mempermudah identifikasi varian rasa dan keterbacaan tabel legalitas.'}
              </p>
            </div>

            <div
              class="pouch-kinetic-stage"
              data-motion="pop"
              data-scroll-speed="0.1"
              data-scroll-rot={pouch.tiltAngle}
              style="--m-delay: 80ms;"
            >
              <div
                class="pouch-float-wrapper"
                style={`--pouch-float-delay: ${(index * 0.9).toFixed(1)}s; --pouch-float-duration: ${(4.5 + index * 0.4).toFixed(1)}s;`}
              >
                <div
                  class="flip-card w-full h-[380px] sm:h-[430px] md:h-[460px] cursor-grab active:cursor-grabbing"
                  data-flip-card={pouch.id}
                  role="button"
                  tabindex="0"
                  aria-label={`${pouch.title} kemasan 3D. Klik untuk membalik tampak depan dan belakang.`}
                >
                  <div class="flip-card-inner" id={pouch.id}>
                    <div class="flip-card-front flex flex-col items-center">
                      <img
                        alt={`${pouch.title} tampak depan`}
                        class="h-[330px] sm:h-[380px] md:h-[410px] w-auto object-contain filter drop-shadow-md select-none"
                        width={pouch.front.width}
                        height={pouch.front.height}
                        loading="eager"
                        decoding="async"
                        src={pouch.front.src}
                      />
                      <span class="mt-3 text-[10px] md:text-xs uppercase font-mono tracking-widest text-zinc-500" data-i18n="kemasan.front">
                        Tampak Depan
                      </span>
                    </div>
                    <div class="flip-card-back flex flex-col items-center">
                      <img
                        alt={`${pouch.title} tampak belakang`}
                        class="h-[330px] sm:h-[380px] md:h-[410px] w-auto object-contain filter drop-shadow-md select-none"
                        width={pouch.back.width}
                        height={pouch.back.height}
                        loading="eager"
                        decoding="async"
                        src={pouch.back.src}
                      />
                      <span class="mt-3 text-[10px] md:text-xs uppercase font-mono tracking-widest text-zinc-500" data-i18n="kemasan.back">
                        Tampak Belakang
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Editorial Packaging Colophon (Zero Card Slop, Pure Typography) -->
    <div
      class="mt-16 pt-6 border-t border-paper-line flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 text-xs font-mono text-zinc-500"
      data-motion="up"
    >
      <span class="uppercase tracking-wider" data-i18n="kemasan.colophon1">STANDARISASI LEGALITAS KEMASAN PANGAN UMKM BINAAN CSR</span>
      <span data-i18n="kemasan.colophon2">NOMOR P-IRT DINKES · SERTIFIKASI HALAL · NUTRITION FACTS</span>
    </div>
  </div>
</section>
