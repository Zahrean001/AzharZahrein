---
import { sijagungScreens } from '../data/portfolio';

export interface OptimizedAsset {
  src: string;
  width: number | string;
  height: number | string;
}

interface Props {
  screens: OptimizedAsset[];
}

const { screens } = Astro.props;
---

<section
  class="relative pt-12 md:pt-16 pb-16 md:pb-20 px-6 sm:px-10 md:px-14 lg:px-20 border-b border-paper-line"
  id="sijagung"
>
  <div class="relative z-10 w-full max-w-5xl mx-auto">
    <!-- Header & Positioning -->
    <div class="space-y-3 mb-8 md:mb-10">
      <div class="text-xs font-mono uppercase tracking-widest text-zinc-500" data-i18n="sijagung.eyebrow">
        Studi Kasus Rekayasa Perangkat Lunak · Desa Kelubir
      </div>

      <h2
        class="font-editorial-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-ink leading-tight"
        data-motion="up"
        data-scroll-speed="-0.05"
      >
        SIJAGUNG
      </h2>
      <p
        class="text-base sm:text-lg md:text-xl text-zinc-800 leading-snug font-medium"
        data-motion="up"
        data-scroll-speed="-0.03"
        data-i18n="sijagung.subtitle"
      >
        Aplikasi mobile pemantauan pertanian jagung untuk Desa Kelubir.
      </p>
      <p
        class="text-xs sm:text-sm md:text-base text-zinc-600 leading-relaxed font-normal max-w-2xl"
        data-motion="up"
        data-scroll-speed="-0.02"
        data-i18n="sijagung.desc"
      >
        Aplikasi mobile berarsitektur offline-first dengan Flutter untuk pencatatan petani, lahan, dan hasil panen di Desa Kelubir. Data tersimpan lokal di SQLite dan tersinkronisasi otomatis ke backend Laravel REST API & MySQL saat sinyal tersedia.
      </p>

      <div class="flex items-center flex-wrap gap-2 pt-1" data-motion="fade-right">
        <span class="text-xs font-mono uppercase tracking-wider text-zinc-400">Stack:</span>
        <span class="px-2.5 py-0.5 border border-paper-line bg-white/60 text-zinc-800 font-mono text-xs">Flutter</span>
        <span class="px-2.5 py-0.5 border border-paper-line bg-white/60 text-zinc-800 font-mono text-xs">SQLite</span>
        <span class="px-2.5 py-0.5 border border-paper-line bg-white/60 text-zinc-800 font-mono text-xs">Laravel 10</span>
        <span class="px-2.5 py-0.5 border border-paper-line bg-white/60 text-zinc-800 font-mono text-xs">MySQL</span>
        <span class="px-2.5 py-0.5 border border-paper-line bg-white/60 text-zinc-800 font-mono text-xs">REST API</span>
      </div>
    </div>

    <!-- Phone Interactive Showcase (Real Product Hero Moment) -->
    <div class="relative pt-2 pb-4" id="sijagung-scroll-track">
      <div class="flex flex-col items-center">
        <div class="mb-4 text-center">
          <span
            class="inline-block text-xs sm:text-sm font-mono uppercase tracking-widest text-zinc-500 transition-all duration-150"
            id="screen-title"
            data-i18n="sijagung.defaultTitle"
          >
            Dashboard · Data Petani · Data Panen
          </span>
        </div>

        <div class="phone-stage-wrapper" id="sijagung-fan-stage">
          <div
            class="phone-side-icon phone-side-tl"
            data-phone-stack="0"
            aria-label="Laravel — Backend Framework"
          >
            <span class="phone-side-badge">Laravel</span>
            <svg
              class="w-20 h-[70px] sm:w-28 sm:h-[98px] md:w-32 md:h-[112px]"
              viewBox="0 0 80 68"
              fill="none"
            >
              <polygon points="44,44 77,54 42,67 9,54" fill="rgba(12,12,12,0.16)" />
              <polygon points="4,23 40,41 40,59 4,41" fill="#EF4444" />
              <polygon points="76,23 40,41 40,59 76,41" fill="#B91C1C" />
              <polygon points="40,5 76,23 40,41 4,23" fill="#F87171" />
              <polyline
                points="4,23 40,5 76,23"
                stroke="rgba(255,255,255,0.48)"
                stroke-width="1.4"
                fill="none"
              />
              <g
                transform="translate(40, 23) scale(1.32) translate(-40, -34)"
                stroke="#ffffff"
                stroke-width="2"
                stroke-linejoin="round"
                fill="none"
              >
                <polygon points="34,27 42,31 34,35 26,31" />
                <polygon points="44,32 51,35 44,39 37,35" />
                <polyline points="26,31 26,37 37,42 51,35" />
              </g>
            </svg>
          </div>

          <div
            class="phone-side-icon phone-side-bl"
            data-phone-stack="1"
            aria-label="MySQL — Database"
          >
            <span class="phone-side-badge">MySQL</span>
            <svg
              class="w-20 h-[70px] sm:w-28 sm:h-[98px] md:w-32 md:h-[112px]"
              viewBox="0 0 80 68"
              fill="none"
            >
              <polygon points="44,44 77,54 42,67 9,54" fill="rgba(12,12,12,0.16)" />
              <polygon points="4,23 40,41 40,59 4,41" fill="#00758F" />
              <polygon points="76,23 40,41 40,59 76,41" fill="#0E4F63" />
              <polygon points="40,5 76,23 40,41 4,23" fill="#22D3EE" />
              <polyline
                points="4,23 40,5 76,23"
                stroke="rgba(255,255,255,0.48)"
                stroke-width="1.4"
                fill="none"
              />
              <g
                transform="translate(40, 23) scale(1.32) translate(-40, -34)"
                stroke="#ffffff"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
              >
                <ellipse cx="40" cy="29" rx="9" ry="3.5" />
                <path d="M31 29v7c0 2 4 3.5 9 3.5s9-1.5 9-3.5v-7" />
                <path d="M31 32.5c0 2 4 3.5 9 3.5s9-1.5 9-3.5" />
              </g>
            </svg>
          </div>

          <div
            class="phone-side-icon phone-side-tr"
            data-phone-stack="2"
            aria-label="Flutter — Mobile UI SDK"
          >
            <span class="phone-side-badge">Flutter</span>
            <svg
              class="w-28 h-[98px] sm:w-36 sm:h-[126px] md:w-44 md:h-[154px]"
              viewBox="0 0 80 68"
              fill="none"
            >
              <polygon points="42,43 78,53 42,67 6,53" fill="rgba(12,12,12,0.17)" />
              <polygon points="4,23 40,41 40,59 4,41" fill="#0284C7" />
              <polygon points="76,23 40,41 40,59 76,41" fill="#0369A1" />
              <polygon points="40,5 76,23 40,41 4,23" fill="#38BDF8" />
              <polyline
                points="4,23 40,5 76,23"
                stroke="rgba(255,255,255,0.52)"
                stroke-width="1.5"
                fill="none"
              />
              <g
                transform="translate(40, 23) scale(1.36) translate(-40, -34)"
                fill="#ffffff"
              >
                <polygon points="38,26 45,26 33,36 28,33" />
                <polygon points="39,33 46,33 38,40 45,43 38,43 33,38" />
              </g>
            </svg>
          </div>

          <div
            class="phone-side-icon phone-side-br"
            data-phone-stack="3"
            aria-label="Dart — Programming Language"
          >
            <span class="phone-side-badge">Dart</span>
            <svg
              class="w-20 h-[70px] sm:w-24 sm:h-[84px] md:w-28 md:h-[98px]"
              viewBox="0 0 80 68"
              fill="none"
            >
              <polygon points="42,43 77,53 42,66 7,53" fill="rgba(12,12,12,0.15)" />
              <polygon points="4,23 40,41 40,59 4,41" fill="#0D9488" />
              <polygon points="76,23 40,41 40,59 76,41" fill="#115E59" />
              <polygon points="40,5 76,23 40,41 4,23" fill="#2DD4BF" />
              <polyline
                points="4,23 40,5 76,23"
                stroke="rgba(255,255,255,0.48)"
                stroke-width="1.4"
                fill="none"
              />
              <g
                transform="translate(40, 23) scale(1.32) translate(-40, -34)"
                fill="#ffffff"
              >
                <polygon points="32,28 46,27 50,35 38,41 29,35" />
              </g>
            </svg>
          </div>

          <div class="phone-fan-group">
            {
              sijagungScreens.map((meta, index) => {
                const asset = screens[index];
                return (
                  <div
                    class={`phone-fan-item ${meta.positionClass}`}
                    data-fan-phone={meta.id}
                    aria-label={`Layar ${meta.title} SIJAGUNG`}
                  >
                    <div class="w-[210px] sm:w-[250px] md:w-[276px] phone-hardware">
                      <div class="phone-inner-bezel">
                        <div class="phone-status-bar">
                          <span class="text-[10px] sm:text-[11px] font-semibold tracking-tight text-zinc-200 font-sans">
                            09:41
                          </span>
                          <div class="phone-dynamic-island" aria-hidden="true">
                            <span class="phone-camera-dot" />
                          </div>
                          <div class="flex items-center gap-1 text-zinc-200" aria-hidden="true">
                            <div class="w-4 h-2 rounded-[2px] border border-zinc-300/80 p-[1px] flex items-center">
                              <div class="w-full h-full bg-emerald-400 rounded-[1px]" />
                            </div>
                          </div>
                        </div>
                        <div class="relative w-full aspect-[496/1024] overflow-hidden bg-[#0a0f0c]">
                          <img
                            alt={meta.alt}
                            class="w-full h-full object-contain"
                            width={asset.width}
                            height={asset.height}
                            loading="eager"
                            decoding="async"
                            src={asset.src}
                          />
                        </div>
                        <div class="phone-home-bar" aria-hidden="true">
                          <div class="w-20 h-1 rounded-full bg-white/30" />
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>

        <div class="mt-4 text-center max-w-[420px]">
          <p
            class="text-xs sm:text-sm font-mono text-zinc-700 transition-all duration-150"
            id="screen-caption"
            data-i18n="sijagung.defaultCaption"
          >
            “Ringkasan data lapangan, pencatatan petani, dan hasil panen dalam satu alur aplikasi.”
          </p>
        </div>
      </div>
    </div>

    <!-- Toggle Case Study Button (Architectural Hairline Button) -->
    <div class="mt-8 text-center" data-motion="up">
      <button
        type="button"
        id="sijagung-case-study-btn"
        aria-expanded="false"
        aria-controls="sijagung-case-study-panel"
        class="inline-flex items-center gap-2.5 px-6 py-2.5 border border-ink bg-ink text-paper font-mono text-xs font-semibold uppercase tracking-wider hover:bg-zinc-800 transition-colors cursor-pointer"
      >
        <span id="sijagung-btn-label" data-i18n="sijagung.caseStudyBtn">Buka Detail Arsitektur & Studi Kasus</span>
        <svg id="sijagung-chevron" class="w-3.5 h-3.5 text-zinc-400 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </button>
    </div>

    <!-- Technical Case Study Dossier (Crafted Engineering Blueprint — Un-slopped Monograph) -->
    <div
      id="sijagung-case-study-panel"
      class="sijagung-dossier-accordion mt-10"
      aria-hidden="true"
    >
      <div class="sijagung-dossier-inner">
        <div class="border-t border-b border-paper-line py-10 space-y-12 text-ink">
          <!-- Technical Header & Specifications Grid -->
          <div class="space-y-4">
            <div class="flex items-center justify-between flex-wrap gap-2 text-xs font-mono text-zinc-500">
              <span data-i18n="sijagung.dossierHeader">DOKUMEN SPESIFIKASI REKAYASA SISTEM</span>
              <span class="inline-flex items-center gap-2 font-mono text-xs text-zinc-700 uppercase" data-i18n="sijagung.dossierStatus">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                STATUS: TERVERIFIKASI & SIAP UJI LAPANGAN
              </span>
            </div>

            <h3 class="font-editorial-heading text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-ink" data-i18n="sijagung.caseStudyTitle">
              Studi Kasus Teknis: SIJAGUNG
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 font-mono" data-i18n="sijagung.caseStudySubtitle">
              Sistem Informasi Pertanian Jagung Lapangan — Desa Kelubir
            </p>

            <!-- Structured Specifications Matrix (Clean Typographic Hairline Table) -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-0 border border-paper-line divide-x divide-y sm:divide-y-0 divide-paper-line text-xs font-mono bg-white/40">
              <div class="p-3.5">
                <div class="text-zinc-500 text-[11px] uppercase tracking-wider" data-i18n="sijagung.specRegion">Konteks Wilayah</div>
                <div class="text-ink font-semibold pt-1" data-i18n="sijagung.specRegionVal">Desa Kelubir, Bulungan</div>
              </div>
              <div class="p-3.5">
                <div class="text-zinc-500 text-[11px] uppercase tracking-wider" data-i18n="sijagung.specRole">Peran Teknis</div>
                <div class="text-ink font-semibold pt-1" data-i18n="sijagung.specRoleVal">Mobile Dev & UI/UX</div>
              </div>
              <div class="p-3.5">
                <div class="text-zinc-500 text-[11px] uppercase tracking-wider" data-i18n="sijagung.specArch">Arsitektur Data</div>
                <div class="text-ink font-semibold pt-1" data-i18n="sijagung.specArchVal">Offline-First / SQLite WAL</div>
              </div>
              <div class="p-3.5">
                <div class="text-zinc-500 text-[11px] uppercase tracking-wider" data-i18n="sijagung.specSync">Protokol Sinkronisasi</div>
                <div class="text-ink font-semibold pt-1" data-i18n="sijagung.specSyncVal">Idempotent REST Queue</div>
              </div>
            </div>
          </div>

          <!-- 1. Architectural Blueprint & Interactive Data Flow Simulator -->
          <div class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
              <div class="text-xs font-mono uppercase tracking-widest text-zinc-800 font-bold" data-i18n="sijagung.archHeading">
                Arsitektur Sistem & Aliran Data
              </div>
              <div class="text-[11px] font-mono text-zinc-500" data-i18n="sijagung.simHint">
                Pilih mode untuk melihat simulasi aliran data offline-ke-online:
              </div>
            </div>

            <!-- Architectural Blueprint Chassis (High Craft, Technical Slate with Interactive Conduits) -->
            <div class="sijagung-arch-board relative bg-[#0d0f14] text-[#ededed] font-mono text-xs border border-zinc-800 rounded-xl p-5 sm:p-7 shadow-2xl overflow-hidden">
              <!-- Blueprint Radial Ambience & Dot Grid Texture -->
              <div class="absolute inset-0 blueprint-grid pointer-events-none opacity-60" aria-hidden="true"></div>
              <div class="absolute -top-24 -left-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none" id="sijagung-ambient-glow" aria-hidden="true"></div>

              <!-- Schematic Controls & Action Bar -->
              <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-3 pb-4 border-b border-zinc-800/90">
                <div class="flex items-center gap-2.5">
                  <span class="relative flex h-2.5 w-2.5 shrink-0">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75" id="sijagung-ping-ring"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500" id="sijagung-ping-dot"></span>
                  </span>
                  <span class="text-[11px] uppercase tracking-wider text-zinc-200 font-semibold" data-i18n="sijagung.simTitle">
                    Simulasi Pipeline Sinkronisasi Data
                  </span>
                </div>

                <!-- Precision Mode Switcher & Tactical Trigger Button -->
                <div class="flex flex-wrap items-center gap-2">
                  <button
                    type="button"
                    id="sijagung-trigger-harvest"
                    class="sim-action-btn flex items-center gap-1.5 px-3 py-1.5 rounded-md text-[11px] font-semibold font-mono tracking-wide bg-emerald-950/90 hover:bg-emerald-900/90 text-emerald-300 border border-emerald-500/40 transition-all duration-150 cursor-pointer shadow-xs active:scale-95 whitespace-nowrap"
                  >
                    <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    <span id="sijagung-trigger-label">Catat Panen Baru</span>
                  </button>

                  <div class="flex items-center p-0.5 bg-zinc-950 border border-zinc-800 rounded-lg text-[11px] shadow-inner" id="sijagung-sim-controls">
                    <button
                      type="button"
                      id="sijagung-sim-offline"
                      class="sim-mode-btn flex items-center gap-1.5 px-3 py-1.5 rounded-md text-[11px] font-semibold tracking-wide transition-all duration-200 cursor-pointer bg-zinc-800 text-emerald-400 border border-emerald-500/30 shadow-xs whitespace-nowrap"
                      data-mode="offline"
                      aria-pressed="true"
                    >
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)] shrink-0"></span>
                      <span data-i18n="sijagung.modeOffline">Mode Ladang (Offline)</span>
                    </button>
                    <button
                      type="button"
                      id="sijagung-sim-online"
                      class="sim-mode-btn flex items-center gap-1.5 px-3 py-1.5 rounded-md text-[11px] font-semibold tracking-wide transition-all duration-200 cursor-pointer text-zinc-400 hover:text-zinc-200 whitespace-nowrap"
                      data-mode="online"
                      aria-pressed="false"
                    >
                      <span class="w-1.5 h-1.5 rounded-full bg-zinc-600 transition-colors shrink-0" id="sijagung-online-led"></span>
                      <span data-i18n="sijagung.modeOnline">Sinyal Terhubung (Auto-Sync)</span>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Interactive Integrated Circuit Pipeline (Zero-Overflow Responsive Architecture) -->
              <div class="relative z-10 pt-4 pb-3">
                <!-- Overhead Optical Circuit Conduit Bus (Desktop 5-Column Aligned) -->
                <div class="hidden lg:block relative h-11 mb-1 select-none" aria-hidden="true">
                  <!-- Base Bus Track Spanning Column 1 Center (10%) to Column 5 Center (90%) -->
                  <div class="absolute left-[10%] right-[10%] top-5 h-2 bg-zinc-950 rounded-full border border-zinc-800/90"></div>

                  <!-- Segment 1 (10% -> 30%): Local High-Speed WAL Bus (Always Active) -->
                  <div class="absolute left-[10%] w-[20%] top-5 h-2 rounded-l-full bg-emerald-950/60 border border-emerald-500/40 overflow-hidden flex items-center">
                    <div class="w-full h-[2px] bg-emerald-400 shadow-[0_0_8px_#34d399]"></div>
                    <div class="conduit-photon conduit-photon-local"></div>
                  </div>
                  <div class="absolute left-[20%] -translate-x-1/2 top-0 text-[9px] font-mono text-emerald-400 font-semibold tracking-tight whitespace-nowrap">
                    WAL BUS · &lt;1.2ms
                  </div>

                  <!-- Segment 2 (30% -> 50%): Cellular Sync Gateway Checkpoint -->
                  <div class="absolute left-[30%] w-[20%] top-5 h-2 bg-zinc-950 border-y border-zinc-800 overflow-hidden flex items-center" id="sijagung-gate-track">
                    <div class="w-full h-[2px] bg-zinc-800 transition-colors duration-300" id="sijagung-gate-line"></div>
                    <div class="conduit-photon conduit-photon-sync hidden" id="sijagung-gate-photon-1"></div>
                    <div class="conduit-photon conduit-photon-sync-2 hidden" id="sijagung-gate-photon-2"></div>
                  </div>
                  <!-- Gateway Status Pill Centered on Segment 2 (40%) -->
                  <div class="absolute left-[40%] -translate-x-1/2 top-0 flex items-center gap-1.5 z-20 whitespace-nowrap">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse" id="sijagung-gate-led"></span>
                    <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-zinc-900 text-amber-400 border border-amber-500/40 shadow-xs" id="sijagung-gate-status-pill">
                      GATEWAY: OFFLINE
                    </span>
                    <span class="text-[9px] font-mono text-zinc-400 font-semibold" id="sijagung-gate-counter">
                      (12 QUEUED)
                    </span>
                  </div>

                  <!-- Segment 3 (50% -> 70%): Secure HTTPS JSON Transport Bus -->
                  <div class="absolute left-[50%] w-[20%] top-5 h-2 bg-zinc-950 border-y border-zinc-800 overflow-hidden flex items-center">
                    <div class="w-full h-[2px] bg-zinc-800 transition-colors duration-300" id="sijagung-http-line"></div>
                    <div class="conduit-photon conduit-photon-cloud hidden" id="sijagung-http-photon"></div>
                  </div>
                  <div class="absolute left-[60%] -translate-x-1/2 top-0 text-[9px] font-mono text-zinc-500 whitespace-nowrap" id="sijagung-http-label">
                    JSON POST · TLS 1.3
                  </div>

                  <!-- Segment 4 (70% -> 90%): ACID SQL Commit Bus -->
                  <div class="absolute left-[70%] w-[20%] top-5 h-2 rounded-r-full bg-zinc-950 border border-zinc-800 overflow-hidden flex items-center">
                    <div class="w-full h-[2px] bg-zinc-800 transition-colors duration-300" id="sijagung-db-line"></div>
                    <div class="conduit-photon conduit-photon-commit hidden" id="sijagung-db-photon"></div>
                  </div>
                  <div class="absolute left-[80%] -translate-x-1/2 top-0 text-[9px] font-mono text-zinc-500 whitespace-nowrap" id="sijagung-db-label">
                    ACID COMMIT · TCP
                  </div>

                  <!-- 5 Vertical Drop-Vias Connecting Bus Directly Into Each Node Card -->
                  <div class="absolute left-[10%] -translate-x-1/2 top-6 w-[2px] h-5 bg-emerald-500/70"></div>
                  <div class="absolute left-[30%] -translate-x-1/2 top-6 w-[2px] h-5 bg-emerald-500/70"></div>
                  <div class="absolute left-[50%] -translate-x-1/2 top-6 w-[2px] h-5 bg-zinc-700 transition-colors duration-300" id="sijagung-via-3"></div>
                  <div class="absolute left-[70%] -translate-x-1/2 top-6 w-[2px] h-5 bg-zinc-700 transition-colors duration-300" id="sijagung-via-4"></div>
                  <div class="absolute left-[90%] -translate-x-1/2 top-6 w-[2px] h-5 bg-zinc-700 transition-colors duration-300" id="sijagung-via-5"></div>
                </div>

                <!-- 5 Spacious Architecture Nodes (Zero Horizontal Scrollbar) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-stretch relative">
                  <!-- Node 1: Flutter Client -->
                  <div
                    id="arch-node-1"
                    data-node-id="1"
