    animation: localBusFlow 2s ease-in-out infinite alternate;
  }

  @keyframes localBusFlow {
    0% {
      left: 10%;
      opacity: 0.4;
      transform: translateY(-50%) scale(0.8);
    }
    50% {
      opacity: 1;
      transform: translateY(-50%) scale(1.3);
    }
    100% {
      left: 85%;
      opacity: 0.4;
      transform: translateY(-50%) scale(0.8);
    }
  }

  .conduit-photon-sync {
    background-color: #38bdf8;
    box-shadow: 0 0 10px #38bdf8, 0 0 18px rgba(56, 189, 248, 0.9);
    animation: syncBusFlow 1.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .conduit-photon-sync-2 {
    background-color: #38bdf8;
    box-shadow: 0 0 10px #38bdf8, 0 0 18px rgba(56, 189, 248, 0.9);
    animation: syncBusFlow 1.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    animation-delay: 0.6s;
  }

  @keyframes syncBusFlow {
    0% {
      left: 0%;
      opacity: 0;
      transform: translateY(-50%) scale(0.7);
