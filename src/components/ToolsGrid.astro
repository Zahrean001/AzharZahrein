---
import { lane1Tools, lane2Tools, lane3Tools, categorizedSkills } from '../data/portfolio';
---

<section
  class="relative pt-16 md:pt-24 pb-20 md:pb-28 px-4 sm:px-8 md:px-12 lg:px-16 border-b border-paper-line overflow-hidden"
  id="tools"
>
  <div
    class="bg-watermark-wrap top-12 md:top-16"
    data-watermark
    data-watermark-speed="0.18"
    aria-hidden="true"
  >
    <div class="bg-watermark-text">TOOLKIT</div>
  </div>

  <div class="relative z-10 w-full max-w-6xl mx-auto space-y-12">
    <!-- Header -->
    <div class="space-y-3">
      <div class="text-xs font-mono uppercase tracking-widest text-zinc-500" data-i18n="tools.eyebrow">
        05 / Keahlian Teknis & Alat Kerja
      </div>
      <h2
        class="font-editorial-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-ink leading-tight"
        data-motion="up"
        data-scroll-speed="-0.06"
        data-i18n="tools.heading"
      >
        Keahlian Teknis & Alat Kerja
      </h2>
      <p
        class="text-sm sm:text-base md:text-lg text-zinc-700 leading-relaxed max-w-3xl"
        data-motion="up"
        data-scroll-speed="-0.04"
        data-i18n="tools.desc"
      >
        Klasifikasi keahlian terstruktur yang saya terapkan dalam rekayasa aplikasi serta teknologi yang sedang aktif saya pelajari.
      </p>
    </div>

    <!-- 1. Interactive 3D Isometric Conveyor Showcase (3 Parallel Diagonal Lanes, Infinite Loop) -->
    <div class="space-y-4">
      <!-- Status Legend & Interaction Hint -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-mono text-zinc-500 pt-2 border-b border-paper-line pb-3">
        <div class="flex items-center gap-2">
          <span class="font-bold text-zinc-800" data-i18n="tools.isoTitle">Showcase Isometrik 3D · Interaktif</span>
          <span class="hidden md:inline-block text-zinc-400">|</span>
          <span class="hidden md:inline-block text-[11px] text-zinc-500" data-i18n="tools.wheelHint">
            Arahkan kursor & putar scroll wheel mouse untuk menggeser horizontal ⇄
          </span>
        </div>
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center gap-1.5 font-mono text-[11px]">
            <span class="text-zinc-950 font-bold" data-i18n="tools.tagActive">[DIKUASAI]</span>
            <span data-i18n="tools.statusActive" class="text-zinc-800 font-semibold">Dikuasai (Aktif)</span>
          </span>
          <span class="inline-flex items-center gap-1.5 font-mono text-[11px]">
            <span class="text-zinc-400" data-i18n="tools.tagLearning">[EKSPLORASI]</span>
            <span data-i18n="tools.statusLearning" class="text-zinc-400">Eksplorasi (Warna Nonaktif)</span>
          </span>
        </div>
      </div>

      <!-- Mobile Hint visible on small screens -->
      <div class="block md:hidden text-[11px] font-mono text-zinc-500 text-center" data-i18n="tools.wheelHint">
        Arahkan kursor & putar scroll wheel mouse untuk menggeser horizontal ⇄
      </div>

      <!-- Isometric 3D Showcase Stage -->
      <div class="iso-showcase-container" id="iso-tools-container">
        <!-- Static zero-cost edge gradient fades -->
        <div class="iso-edge-fade-left" aria-hidden="true"></div>
        <div class="iso-edge-fade-right" aria-hidden="true"></div>

        <div
          class="iso-scene"
          id="iso-tools-scene"
          tabindex="0"
          role="region"
          aria-label="3D Isometric Tech Stack Conveyor"
        >
          <div class="iso-plane" id="iso-tools-plane">
            <!-- Lane 1: Mobile & Frontend Frameworks -->
            <div class="iso-lane" data-lane="1" id="iso-lane-1">
              <div class="iso-lane-track" id="iso-lane-track-1">
                {
                  [...lane1Tools, ...lane1Tools, ...lane1Tools].map((tool, idx) => {
                    const statusLabel =
                      tool.status === 'active' ? '[DIKUASAI] Teruji di Proyek' : '[EKSPLORASI] Warna Nonaktif';
                    return (
                      <div
                        class="iso-item group"
                        data-status={tool.status}
                        data-tool-id={tool.id}
                        data-category={tool.category}
                        tabindex="0"
                        role="button"
                        aria-label={`${tool.name} — ${statusLabel}`}
                      >
                        <div class="iso-float-wrapper">
                          <svg
                            class="iso-object-svg w-24 h-[84px] sm:w-28 sm:h-[98px] md:w-32 md:h-[112px] lg:w-36 lg:h-[126px]"
                            viewBox="0 0 80 68"
                            fill="none"
                            aria-hidden="true"
                          >
                            <polygon points="42,42 77,52 42,66 7,52" fill="rgba(12,12,12,0.14)" />
                            <polygon points="4,23 40,41 40,59 4,41" fill={tool.leftColor} />
                            <polygon points="76,23 40,41 40,59 76,41" fill={tool.rightColor} />
                            <polygon points="40,5 76,23 40,41 4,23" fill={tool.topColor} />
                            <polyline
                              points="4,23 40,5 76,23"
                              stroke="rgba(255,255,255,0.48)"
                              stroke-width="1.4"
                              fill="none"
                            />

                            <g transform="translate(40, 23) scale(1.3) translate(-40, -34)">
                              {tool.glyph === 'flutter' && (
                                <g fill="#ffffff">
                                  <polygon points="38,26 45,26 33,36 28,33" />
                                  <polygon points="38,42 45,42 36,33 30,36" />
                                </g>
                              )}
                              {tool.glyph === 'dart' && (
                                <polygon points="32,26 44,26 48,34 36,42 32,38" fill="#ffffff" />
                              )}
                              {tool.glyph === 'html' && (
                                <g>
                                  <path d="M33 26 L47 26 L45.5 39 L40 42 L34.5 39 Z" fill="none" stroke="#ffffff" stroke-width="1.6" />
                                  <text x="40" y="36" text-anchor="middle" fill="#ffffff" font-family="system-ui, sans-serif" font-size="8.5" font-weight="900">HTML</text>
                                </g>
                              )}
                              {tool.glyph === 'css' && (
                                <g>
                                  <path d="M33 26 L47 26 L45.5 39 L40 42 L34.5 39 Z" fill="none" stroke="#ffffff" stroke-width="1.6" />
                                  <text x="40" y="36" text-anchor="middle" fill="#ffffff" font-family="system-ui, sans-serif" font-size="9" font-weight="900">CSS</text>
                                </g>
                              )}
                              {tool.glyph === 'tailwind' && (
                                <path
                                  d="M32 35 Q36 30 40 33 Q44 36 48 32 M32 39 Q36 34 40 37 Q44 40 48 36"
                                  stroke="#ffffff"
                                  stroke-width="2.2"
                                  stroke-linecap="round"
                                  fill="none"
                                />
                              )}
                              {tool.glyph === 'bootstrap' && (
                                <g>
                                  <rect x="33" y="26.5" width="14" height="15" rx="3.5" fill="none" stroke="#ffffff" stroke-width="1.6" />
                                  <text x="40" y="38" text-anchor="middle" fill="#ffffff" font-family="Georgia, serif" font-size="11" font-weight="900">B</text>
                                </g>
                              )}
                              {tool.glyph === 'react' && (
                                <g stroke="#d4d4d8" stroke-width="1.2" fill="none">
                                  <ellipse cx="40" cy="34" rx="8" ry="3.2" />
                                  <ellipse cx="40" cy="34" rx="8" ry="3.2" transform="rotate(60 40 34)" />
                                  <ellipse cx="40" cy="34" rx="8" ry="3.2" transform="rotate(120 40 34)" />
                                  <circle cx="40" cy="34" r="1.5" fill="#d4d4d8" />
                                </g>
                              )}
                              {tool.glyph === 'vue' && (
                                <g fill="#d4d4d8">
                                  <polygon points="32,27 40,41 48,27 44,27 40,34 36,27" />
                                  <polygon points="36,27 40,34 44,27 41.5,27 40,29.5 38.5,27" opacity="0.6" />
                                </g>
                              )}
                              {tool.glyph === 'nextjs' && (
                                <g fill="#d4d4d8">
                                  <circle cx="40" cy="34" r="8" fill="none" stroke="#d4d4d8" stroke-width="1.4" />
                                  <path d="M36.5 38.5 L36.5 29.5 L43 38.5 M43 29.5 L43 34" stroke="#d4d4d8" stroke-width="1.4" stroke-linecap="round" fill="none" />
                                </g>
                              )}
                              {tool.glyph === 'astro' && (
                                <g fill="#d4d4d8">
                                  <polygon points="34,41 40,26 46,41 40,36" />
                                  <circle cx="40" cy="33" r="1.4" fill="#fb7185" />
                                </g>
                              )}
                              {tool.glyph === 'vite' && (
                                <g fill="#d4d4d8">
                                  <polygon points="39,26 33,35 39,35 37,42 47,33 41,33 43,26" />
                                </g>
                              )}
                              {tool.glyph === 'kotlin' && (
                                <g fill="#d4d4d8">
                                  <polygon points="33,27 47,27 40,34 33,41" />
                                  <polygon points="40,34 47,27 47,41 40,41" opacity="0.6" />
                                </g>
                              )}
                              {tool.glyph === 'swift' && (
                                <path d="M47 38.5 C44 41 38 41 33 36 C35.5 37 38 36.5 40 35 C37 34 34.5 31 35 27 C37 29.5 40 31.5 44 32 C41.5 29 42 27 43 26 C44.5 28 46 32 47 38.5 Z" fill="#d4d4d8" />
                              )}
                              {tool.glyph === 'sass' && (
                                <text x="40" y="38" text-anchor="middle" fill="#d4d4d8" font-family="system-ui, sans-serif" font-size="9" font-weight="800" font-style="italic">Sass</text>
                              )}
                            </g>
                          </svg>
                        </div>

                        <div class="iso-tooltip" role="tooltip">
                          <div class="text-xs font-semibold tracking-tight">{tool.name}</div>
                          <div class="text-[10px] font-mono text-zinc-300">{statusLabel}</div>
                        </div>
                      </div>
                    );
                  })
                }
              </div>
            </div>

            <!-- Lane 2: Backend, Languages & Databases -->
            <div class="iso-lane" data-lane="2" id="iso-lane-2">
              <div class="iso-lane-track" id="iso-lane-track-2">
                {
                  [...lane2Tools, ...lane2Tools, ...lane2Tools].map((tool) => {
                    const statusLabel =
                      tool.status === 'active' ? '[DIKUASAI] Teruji di Proyek' : '[EKSPLORASI] Warna Nonaktif';
                    return (
                      <div
                        class="iso-item group"
                        data-status={tool.status}
                        data-tool-id={tool.id}
                        data-category={tool.category}
                        tabindex="0"
                        role="button"
                        aria-label={`${tool.name} — ${statusLabel}`}
                      >
                        <div class="iso-float-wrapper">
                          <svg
                            class="iso-object-svg w-24 h-[84px] sm:w-28 sm:h-[98px] md:w-32 md:h-[112px] lg:w-36 lg:h-[126px]"
                            viewBox="0 0 80 68"
                            fill="none"
                            aria-hidden="true"
                          >
                            <polygon points="42,42 77,52 42,66 7,52" fill="rgba(12,12,12,0.14)" />
                            <polygon points="4,23 40,41 40,59 4,41" fill={tool.leftColor} />
                            <polygon points="76,23 40,41 40,59 76,41" fill={tool.rightColor} />
                            <polygon points="40,5 76,23 40,41 4,23" fill={tool.topColor} />
                            <polyline
                              points="4,23 40,5 76,23"
                              stroke="rgba(255,255,255,0.48)"
                              stroke-width="1.4"
                              fill="none"
                            />

                            <g transform="translate(40, 23) scale(1.3) translate(-40, -34)">
                              {tool.glyph === 'laravel' && (
                                <path
                                  d="M33,30 L40,26 L47,30 L40,34 Z M40,35 L47,31 L47,39 L40,43 Z M33,31 L40,35 L40,43 L33,39 Z"
                                  fill="#ffffff"
                                />
                              )}
                              {tool.glyph === 'php' && (
                                <text
                                  x="40"
                                  y="38"
                                  text-anchor="middle"
                                  fill="#ffffff"
                                  font-family="system-ui, -apple-system, sans-serif"
                                  font-size="11"
                                  font-weight="800"
                                >
                                  PHP
                                </text>
                              )}
                              {tool.glyph === 'api' && (
                                <g fill="#ffffff">
                                  <text
                                    x="40"
                                    y="36"
                                    text-anchor="middle"
                                    font-family="system-ui, -apple-system, sans-serif"
                                    font-size="10"
                                    font-weight="800"
                                  >
                                    REST
                                  </text>
                                  <circle cx="34" cy="41" r="1.5" />
                                  <circle cx="40" cy="41" r="1.5" />
                                  <circle cx="46" cy="41" r="1.5" />
                                </g>
                              )}
                              {tool.glyph === 'mysql' && (
                                <g stroke="#ffffff" stroke-width="1.6" fill="none" stroke-linecap="round">
                                  <ellipse cx="40" cy="28" rx="8" ry="3" fill="rgba(255,255,255,0.25)" />
                                  <path d="M32 28v4.5c0 1.6 3.6 2.8 8 2.8s8-1.2 8-2.8v-4.5" />
                                  <path d="M32 32.5v4.5c0 1.6 3.6 2.8 8 2.8s8-1.2 8-2.8v-4.5" />
                                </g>
                              )}
                              {tool.glyph === 'nodejs' && (
                                <g stroke="#d4d4d8" stroke-width="1.4" fill="none">
                                  <polygon points="40,26 47,30 47,38 40,42 33,38 33,30" />
                                  <text x="40" y="37" text-anchor="middle" stroke="none" fill="#d4d4d8" font-family="system-ui, sans-serif" font-size="8.5" font-weight="900">NODE</text>
                                </g>
                              )}
                              {tool.glyph === 'python' && (
                                <g stroke="#d4d4d8" stroke-width="1.5" stroke-linecap="round" fill="none">
                                  <path d="M38 27 h-3 a3 3 0 0 0 -3 3 v3 a3 3 0 0 0 3 3 h5 v-2" />
                                  <path d="M42 41 h3 a3 3 0 0 0 3 -3 v-3 a3 3 0 0 0 -3 -3 h-5 v2" />
                                  <circle cx="35" cy="30" r="0.75" fill="#d4d4d8" stroke="none" />
                                  <circle cx="45" cy="38" r="0.75" fill="#d4d4d8" stroke="none" />
                                </g>
                              )}
                              {tool.glyph === 'ts' && (
                                <g>
                                  <rect x="31" y="27" width="18" height="15" rx="1.5" fill="none" stroke="#d4d4d8" stroke-width="1.4" />
                                  <text
                                    x="40"
                                    y="38.5"
                                    text-anchor="middle"
                                    fill="#d4d4d8"
                                    font-family="system-ui, -apple-system, sans-serif"
                                    font-size="9"
                                    font-weight="800"
                                  >
                                    TS
                                  </text>
                                </g>
                              )}
                              {tool.glyph === 'express' && (
                                <text x="40" y="38" text-anchor="middle" fill="#d4d4d8" font-family="system-ui, sans-serif" font-size="8.5" font-weight="800">EXPRESS</text>
                              )}
                              {tool.glyph === 'postgresql' && (
                                <g stroke="#d4d4d8" stroke-width="1.4" fill="none">
                                  <path d="M33 34 C33 29 37 26 42 26 C46 26 47 28 47 31 C47 36 44 41 40 41 C37 41 36 38 36 34" />
                                  <circle cx="43" cy="30" r="1.2" fill="#d4d4d8" />
                                </g>
                              )}
                              {tool.glyph === 'sqlite' && (
                                <g stroke="#d4d4d8" stroke-width="1.4" fill="none" stroke-linecap="round">
                                  <ellipse cx="40" cy="27" rx="7.5" ry="2.8" />
                                  <path d="M32.5 27v4c0 1.5 3.4 2.6 7.5 2.6s7.5-1.1 7.5-2.6v-4" />
                                  <path d="M32.5 31v4c0 1.5 3.4 2.6 7.5 2.6s7.5-1.1 7.5-2.6v-4" />
                                  <text x="40" y="43" text-anchor="middle" fill="#d4d4d8" stroke="none" font-family="system-ui, sans-serif" font-size="6" font-weight="800">SQLITE</text>
                                </g>
                              )}
                              {tool.glyph === 'redis' && (
                                <g stroke="#d4d4d8" stroke-width="1.3" fill="none">
                                  <polygon points="40,26 47,29.5 40,33 33,29.5" fill="rgba(255,255,255,0.1)" />
                                  <path d="M33 32 L40 35.5 L47 32" />
                                  <path d="M33 36 L40 39.5 L47 36" />
                                </g>
                              )}
                              {tool.glyph === 'mongodb' && (
                                <g fill="#d4d4d8">
                                  <path d="M40 26 C37 31 35 34 35 37 C35 40 37 42 40 43 C43 42 45 40 45 37 C45 34 43 31 40 26 Z" />
                                  <line x1="40" y1="28" x2="40" y2="42" stroke="#18181b" stroke-width="0.8" />
                                </g>
                              )}
                              {tool.glyph === 'graphql' && (
                                <g stroke="#d4d4d8" stroke-width="1.2" fill="none">
                                  <polygon points="40,26 47,30 47,38 40,42 33,38 33,30" />
                                  <circle cx="40" cy="26" r="1.3" fill="#d4d4d8" />
                                  <circle cx="47" cy="30" r="1.3" fill="#d4d4d8" />
                                  <circle cx="47" cy="38" r="1.3" fill="#d4d4d8" />
                                  <circle cx="40" cy="42" r="1.3" fill="#d4d4d8" />
                                  <circle cx="33" cy="38" r="1.3" fill="#d4d4d8" />
                                  <circle cx="33" cy="30" r="1.3" fill="#d4d4d8" />
                                </g>
                              )}
                              {tool.glyph === 'supabase' && (
                                <g fill="#d4d4d8">
                                  <path d="M42 26 L34 36 L40 36 L38 43 L46 33 L40 33 Z" />
                                </g>
                              )}
                            </g>
                          </svg>
                        </div>

                        <div class="iso-tooltip" role="tooltip">
                          <div class="text-xs font-semibold tracking-tight">{tool.name}</div>
                          <div class="text-[10px] font-mono text-zinc-300">{statusLabel}</div>
                        </div>
                      </div>
                    );
                  })
                }
              </div>
            </div>

            <!-- Lane 3: DevOps, Cloud, Tooling & Design -->
            <div class="iso-lane" data-lane="3" id="iso-lane-3">
              <div class="iso-lane-track" id="iso-lane-track-3">
                {
                  [...lane3Tools, ...lane3Tools, ...lane3Tools].map((tool) => {
                    const statusLabel =
                      tool.status === 'active' ? '[DIKUASAI] Teruji di Proyek' : '[EKSPLORASI] Warna Nonaktif';
                    return (
                      <div
                        class="iso-item group"
                        data-status={tool.status}
                        data-tool-id={tool.id}
                        data-category={tool.category}
                        tabindex="0"
                        role="button"
                        aria-label={`${tool.name} — ${statusLabel}`}
                      >
                        <div class="iso-float-wrapper">
                          <svg
                            class="iso-object-svg w-24 h-[84px] sm:w-28 sm:h-[98px] md:w-32 md:h-[112px] lg:w-36 lg:h-[126px]"
                            viewBox="0 0 80 68"
                            fill="none"
                            aria-hidden="true"
                          >
                            <polygon points="42,42 77,52 42,66 7,52" fill="rgba(12,12,12,0.14)" />
                            <polygon points="4,23 40,41 40,59 4,41" fill={tool.leftColor} />
                            <polygon points="76,23 40,41 40,59 76,41" fill={tool.rightColor} />
                            <polygon points="40,5 76,23 40,41 4,23" fill={tool.topColor} />
                            <polyline
                              points="4,23 40,5 76,23"
                              stroke="rgba(255,255,255,0.48)"
                              stroke-width="1.4"
                              fill="none"
                            />

                            <g transform="translate(40, 23) scale(1.3) translate(-40, -34)">
                              {tool.glyph === 'git' && (
                                <g stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" fill="none">
                                  <line x1="36" y1="28" x2="36" y2="40" />
                                  <path d="M36 34 Q39 34 44 31" />
                                  <circle cx="36" cy="28" r="2.2" fill="#ffffff" />
                                  <circle cx="36" cy="40" r="2.2" fill="#ffffff" />
                                  <circle cx="44" cy="31" r="2.2" fill="#ffffff" />
                                </g>
                              )}
                              {tool.glyph === 'github' && (
                                <path
                                  d="M40,26 C36.5,26 33.5,28.8 33.5,32.3 C33.5,35.1 35.3,37.5 37.8,38.3 C38.1,38.4 38.3,38.2 38.3,37.9 L38.3,36.6 C36.5,37 36.1,35.8 36.1,35.8 C35.8,35 35.3,34.8 35.3,34.8 C34.7,34.4 35.3,34.4 35.3,34.4 C36,34.5 36.4,35.1 36.4,35.1 C37,36.2 38,35.9 38.4,35.7 C38.5,35.2 38.7,34.9 38.9,34.7 C37.4,34.5 35.8,33.9 35.8,31.3 C35.8,30.5 36.1,29.9 36.6,29.4 C36.5,29.2 36.3,28.5 36.7,27.4 C36.7,27.4 37.3,27.2 38.8,28.2 C39.4,28 40.1,27.9 40.7,27.9 C41.3,27.9 42,28 42.6,28.2 C44.1,27.2 44.7,27.4 44.7,27.4 C45.1,28.5 44.9,29.2 44.8,29.4 C45.3,29.9 45.6,30.5 45.6,31.3 C45.6,33.9 44,34.5 42.5,34.7 C42.7,34.9 43,35.3 43,35.9 L43,37.9 C43,38.2 43.1,38.4 43.5,38.3 C46,37.5 47.8,35.1 47.8,32.3 C47.8,28.8 44.8,26 40,26 Z"
                                  fill="#ffffff"
                                />
                              )}
                              {tool.glyph === 'aws' && (
                                <g fill="#ffffff">
                                  <text
                                    x="40"
                                    y="35"
                                    text-anchor="middle"
                                    font-family="system-ui, -apple-system, sans-serif"
                                    font-size="9.5"
                                    font-weight="800"
                                  >
                                    AWS
                                  </text>
                                  <path d="M33 38 Q40 42 47 38" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" fill="none" />
                                </g>
                              )}
                              {tool.glyph === 'figma' && (
                                <g fill="#ffffff">
                                  <rect x="34" y="27" width="5.5" height="5.5" rx="2.75" />
                                  <rect x="40.5" y="27" width="5.5" height="5.5" rx="2.75" />
                                  <rect x="34" y="33.5" width="5.5" height="5.5" rx="2.75" />
                                  <circle cx="43.25" cy="36.25" r="2.75" />
                                  <rect x="34" y="40" width="5.5" height="5.5" rx="2.75" />
                                </g>
                              )}
                              {tool.glyph === 'canva' && (
                                <g>
                                  <circle cx="40" cy="34" r="8" fill="none" stroke="#ffffff" stroke-width="1.6" />
                                  <text x="40" y="38" text-anchor="middle" fill="#ffffff" font-family="Georgia, serif" font-size="10" font-weight="900" font-style="italic">C</text>
                                </g>
                              )}
                              {tool.glyph === 'docker' && (
                                <g fill="#d4d4d8">
                                  <rect x="32" y="31" width="3.5" height="3" rx="0.5" />
                                  <rect x="36.5" y="31" width="3.5" height="3" rx="0.5" />
                                  <rect x="41" y="31" width="3.5" height="3" rx="0.5" />
                                  <rect x="34.5" y="27" width="3.5" height="3" rx="0.5" />
                                  <rect x="39" y="27" width="3.5" height="3" rx="0.5" />
                                  <path d="M30 35c1 2.5 5 4 10 4s9-1.5 11-4c-1-1-3-1.5-6-1.5h-9c-3 0-5 .5-6 1.5z" />
                                </g>
                              )}
                              {tool.glyph === 'kubernetes' && (
                                <g stroke="#d4d4d8" stroke-width="1.4" fill="none">
                                  <circle cx="40" cy="34" r="6.5" />
                                  <circle cx="40" cy="34" r="2" fill="#d4d4d8" />
                                  <line x1="40" y1="26" x2="40" y2="42" />
                                  <line x1="33" y1="30" x2="47" y2="38" />
                                  <line x1="33" y1="38" x2="47" y2="30" />
                                </g>
                              )}
                              {tool.glyph === 'linux' && (
                                <g fill="#d4d4d8">
                                  <text x="40" y="37" text-anchor="middle" font-family="monospace" font-size="10" font-weight="900">&gt;_</text>
                                  <rect x="32" y="27" width="16" height="14" rx="2" fill="none" stroke="#d4d4d8" stroke-width="1.3" />
                                </g>
                              )}
                              {tool.glyph === 'postman' && (
                                <g fill="#ffffff">
                                  <text
                                    x="40"
                                    y="36"
                                    text-anchor="middle"
                                    font-family="system-ui, -apple-system, sans-serif"
                                    font-size="8.5"
                                    font-weight="800"
                                  >
                                    POST
                                  </text>
                                  <polygon points="36,38 44,38 40,43" />
                                </g>
                              )}
                              {tool.glyph === 'vercel' && (
                                <polygon points="40,26 48,40 32,40" fill="#ffffff" />
                              )}
                              {tool.glyph === 'ps' && (
                                <g>
                                  <rect x="31" y="27" width="18" height="15" rx="1.5" fill="none" stroke="#d4d4d8" stroke-width="1.4" />
                                  <text
                                    x="40"
                                    y="38.5"
                                    text-anchor="middle"
                                    fill="#d4d4d8"
                                    font-family="system-ui, -apple-system, sans-serif"
                                    font-size="9"
                                    font-weight="800"
                                  >
                                    Ps
                                  </text>
                                </g>
                              )}
                              {tool.glyph === 'ai' && (
                                <g>
                                  <rect x="31" y="27" width="18" height="15" rx="1.5" fill="none" stroke="#d4d4d8" stroke-width="1.4" />
                                  <text
                                    x="40"
                                    y="38.5"
                                    text-anchor="middle"
                                    fill="#d4d4d8"
                                    font-family="system-ui, -apple-system, sans-serif"
                                    font-size="9"
                                    font-weight="800"
                                  >
                                    Ai
                                  </text>
                                </g>
                              )}
                              {tool.glyph === 'coreldraw' && (
                                <g>
                                  <rect x="31" y="27" width="18" height="15" rx="1.5" fill="none" stroke="#d4d4d8" stroke-width="1.4" />
                                  <text
                                    x="40"
                                    y="38.5"
                                    text-anchor="middle"
                                    fill="#d4d4d8"
                                    font-family="system-ui, -apple-system, sans-serif"
                                    font-size="8.5"
                                    font-weight="800"
                                  >
                                    CD
                                  </text>
                                </g>
                              )}
                              {tool.glyph === 'nginx' && (
                                <text x="40" y="37" text-anchor="middle" fill="#d4d4d8" font-family="system-ui, sans-serif" font-size="8" font-weight="900">NGINX</text>
                              )}
                            </g>
                          </svg>
                        </div>

                        <div class="iso-tooltip" role="tooltip">
                          <div class="text-xs font-semibold tracking-tight">{tool.name}</div>
                          <div class="text-[10px] font-mono text-zinc-300">{statusLabel}</div>
                        </div>
                      </div>
                    );
                  })
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Inventaris Keahlian Terverifikasi: High-Craft Dynamic Interactive Ledger -->
    <div class="pt-8 border-t border-paper-line space-y-6" id="skills-inventory-section">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 border-b-2 border-ink pb-3">
        <div>
          <h3
            class="font-editorial-heading text-2xl sm:text-3xl font-bold text-ink"
            data-i18n="tools.matrixHeading"
          >
            Inventaris Keahlian Terverifikasi
          </h3>
          <p class="font-mono text-xs text-zinc-500 uppercase tracking-wider pt-0.5" data-i18n="tools.matrixSubheading">
            Dokumentasi Kompetensi Rekayasa Terstruktur
          </p>
        </div>

        <!-- Interactive Category Filter Tabs -->
        <div class="flex items-center gap-1 font-mono text-xs overflow-x-auto pb-1" id="skill-filter-tabs">
          <button
            type="button"
            data-skill-filter="all"
            class="skill-filter-btn px-2.5 py-1 border border-ink bg-ink text-paper font-semibold cursor-pointer transition-all"
            data-i18n="tools.filterAll"
          >
            Semua
          </button>
          <button
            type="button"
            data-skill-filter="mobile-web"
            class="skill-filter-btn px-2.5 py-1 border border-paper-line bg-white/60 text-zinc-700 hover:text-ink hover:border-zinc-500 cursor-pointer transition-all"
            data-i18n="tools.filterMobile"
          >
            Mobile & Web
          </button>
          <button
            type="button"
            data-skill-filter="backend"
            class="skill-filter-btn px-2.5 py-1 border border-paper-line bg-white/60 text-zinc-700 hover:text-ink hover:border-zinc-500 cursor-pointer transition-all"
            data-i18n="tools.filterBackend"
          >
            Backend & Data
          </button>
          <button
            type="button"
            data-skill-filter="design"
            class="skill-filter-btn px-2.5 py-1 border border-paper-line bg-white/60 text-zinc-700 hover:text-ink hover:border-zinc-500 cursor-pointer transition-all"
            data-i18n="tools.filterDesign"
          >
            UI/UX & Desain
          </button>
          <button
            type="button"
            data-skill-filter="tools"
            class="skill-filter-btn px-2.5 py-1 border border-paper-line bg-white/60 text-zinc-700 hover:text-ink hover:border-zinc-500 cursor-pointer transition-all"
            data-i18n="tools.filterTools"
          >
            Alat & Cloud
          </button>
        </div>
      </div>

      <!-- Architectural 3-Column Stagger Ledger Grid -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10"
        id="skills-matrix-grid"
      >
        {
          categorizedSkills.map((category, catIndex) => (
            <div
              class="skill-category-block space-y-3"
              data-category-group={category.id}
              data-motion="up"
              style={`--m-delay: ${(catIndex * 80)}ms;`}
            >
              <div class="border-b border-paper-line pb-2 flex items-baseline justify-between">
                <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-1.5">
                  <span class="text-zinc-400">[{`0${catIndex + 1}`}]</span>
                  <span class="cat-title-id">{category.titleId}</span>
                  <span class="cat-title-en" style="display: none;">{category.titleEn}</span>
                </h4>
                <span class="text-[10px] font-mono uppercase text-zinc-400">{category.skills.length} Items</span>
              </div>
              <ul class="divide-y divide-paper-line/70">
                {category.skills.map((skill) => (
                  <li
                    class="py-2.5 px-1.5 flex items-baseline justify-between gap-2 text-xs transition-colors duration-150 hover:bg-zinc-900/5 group"
                    data-skill-status={skill.status}
                  >
                    <span class={skill.status === 'active' ? 'font-medium text-zinc-950 group-hover:translate-x-1 transition-transform' : 'text-zinc-600 group-hover:translate-x-1 transition-transform'}>
                      {skill.name}
                    </span>
                    <span
                      class={`font-mono text-[10px] tracking-wider uppercase shrink-0 transition-colors ${
                        skill.status === 'active'
                          ? 'text-zinc-950 font-bold group-hover:text-emerald-700'
                          : 'text-zinc-400 font-normal'
                      }`}
                      data-i18n={skill.status === 'active' ? 'tools.tagActive' : 'tools.tagLearning'}
                    >
                      {skill.status === 'active' ? '[DIKUASAI]' : '[EKSPLORASI]'}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <!-- Swiss Colophon / Verification Footnote -->
      <div class="pt-4 border-t border-paper-line flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11px] font-mono text-zinc-500">
        <span data-i18n="tools.footnote1">[DIKUASAI] = Kemampuan teruji langsung dalam rekayasa aplikasi & alur kerja produksi.</span>
        <span data-i18n="tools.footnote2">[EKSPLORASI] = Teknologi industri dalam kurikulum riset (warna dinonaktifkan).</span>
      </div>
    </div>
  </div>
</section>