---
import { toolItems } from '../data/portfolio';
---

<section
  class="relative pt-16 md:pt-24 pb-20 md:pb-28 px-6 sm:px-10 md:px-14 lg:px-20"
  id="tools"
>
  <div
    class="bg-watermark-wrap top-12 md:top-16"
    data-watermark
    data-watermark-speed="0.18"
    aria-hidden="true"
  >
    <div class="bg-watermark-text">TOOLKIT</div>
  </div>

  <div class="relative z-10 w-full max-w-4xl mx-auto space-y-8">
    <div class="space-y-3">
      <h2
        class="font-editorial-heading text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-ink leading-tight"
        data-motion="up"
        data-scroll-speed="-0.06"
        data-i18n="tools.heading"
        style="--m-delay: 0ms;"
      >
        Tools yang saya kuasai
      </h2>
      <p
        class="text-sm sm:text-base md:text-lg text-zinc-700 leading-relaxed max-w-2xl"
        data-motion="up"
        data-scroll-speed="-0.04"
        data-i18n="tools.desc"
        style="--m-delay: 80ms;"
      >
        Teknologi yang saya gunakan dalam proyek, serta tools yang sedang saya pelajari.
      </p>
    </div>

    <div class="iso-scene" id="iso-tools-scene">
      <div class="iso-plane" id="iso-tools-plane">
        {
          toolItems.map((tool, index) => {
            const staggerMs = Math.floor(index / 6) * 24 + (index % 6) * 12;
            const statusLabel =
              tool.status === 'active' ? 'Digunakan dalam proyek' : 'Sedang dipelajari';

            return (
              <div
                class="iso-item"
                data-status={tool.status}
                data-tool-id={tool.id}
                tabindex="0"
                role="button"
                aria-label={`${tool.name} — ${statusLabel}`}
                style={`--stagger: ${staggerMs}ms; --float-delay: ${(index * 0.22).toFixed(2)}s; --float-duration: ${(3.6 + (index % 5) * 0.4).toFixed(2)}s;`}
              >
                <div class="iso-float-wrapper">
                  <svg
                    class="iso-object-svg w-28 h-[98px] sm:w-32 sm:h-[112px] md:w-36 md:h-[126px]"
                    viewBox="0 0 80 68"
                    fill="none"
                    aria-hidden="true"
                  >
                  <polygon points="42,42 77,52 42,66 7,52" fill="rgba(12,12,12,0.15)" />
                  <polygon points="4,23 40,41 40,59 4,41" fill={tool.leftColor} />
                  <polygon points="76,23 40,41 40,59 76,41" fill={tool.rightColor} />
                  <polygon points="40,5 76,23 40,41 4,23" fill={tool.topColor} />
                  <polyline
                    points="4,23 40,5 76,23"
                    stroke="rgba(255,255,255,0.48)"
                    stroke-width="1.4"
                    fill="none"
                  />

                  <g transform="translate(40, 23) scale(1.32) translate(-40, -34)">
                    {tool.glyph === 'flutter' && (
                      <g fill="#ffffff">
                        <polygon points="38,26 45,26 33,36 28,33" />
                        <polygon points="39,33 46,33 38,40 45,43 38,43 33,38" />
                      </g>
                    )}
                    {tool.glyph === 'dart' && (
                      <g fill="#ffffff">
                        <polygon points="32,28 46,27 50,35 38,41 29,35" />
                      </g>
                    )}
                    {tool.glyph === 'laravel' && (
                      <g stroke="#ffffff" stroke-width="2" stroke-linejoin="round" fill="none">
                        <polygon points="34,27 42,31 34,35 26,31" />
                        <polygon points="44,32 51,35 44,39 37,35" />
                        <polyline points="26,31 26,37 37,42 51,35" />
                      </g>
                    )}
                    {tool.glyph === 'php' && (
                      <text
                        x="40"
                        y="37"
                        text-anchor="middle"
                        fill="#ffffff"
                        font-family="Oswald, sans-serif"
                        font-size="11.5"
                        font-weight="700"
                      >
                        PHP
                      </text>
                    )}
                    {tool.glyph === 'mysql' && (
                      <g stroke="#ffffff" stroke-width="1.8" fill="none">
                        <ellipse cx="40" cy="30" rx="9" ry="3.5" />
                        <path d="M31 30v7c0 2 4 3.5 9 3.5s9-1.5 9-3.5v-7" />
                      </g>
                    )}
                    {tool.glyph === 'api' && (
                      <text
                        x="40"
                        y="37"
                        text-anchor="middle"
                        fill="#ffffff"
                        font-family="Oswald, sans-serif"
                        font-size="11"
                        font-weight="700"
                      >
                        API
                      </text>
                    )}
                    {tool.glyph === 'git' && (
                      <g stroke="#ffffff" stroke-width="2" fill="none">
                        <line x1="33" y1="28" x2="45" y2="39" />
                        <line x1="39" y1="33" x2="34" y2="39" />
                        <circle cx="33" cy="28" r="2.2" fill="#ffffff" />
                        <circle cx="45" cy="39" r="2.2" fill="#ffffff" />
                        <circle cx="34" cy="39" r="2.2" fill="#ffffff" />
                      </g>
                    )}
                    {tool.glyph === 'github' && (
                      <path
                        d="M40 27c-5 0-9 3.2-9 7.2 0 3.2 2.5 5.8 6 6.8v-2.2c-2 .3-2.5-.8-2.5-.8-.4-.8-.9-1-.9-1-.7-.4 0-.4 0-.4.8 0 1.3.7 1.3.7.7 1.1 1.9.8 2.3.6.1-.5.3-.8.6-1-1.8-.2-3.6-.7-3.6-3.3 0-.8.3-1.4.8-1.9-.1-.2-.3-.9.1-1.8 0 0 .6-.2 2 .7.6-.1 1.2-.2 1.9-.2s1.3.1 1.9.2c1.4-.9 2-.7 2-.7.4.9.2 1.6.1 1.8.5.5.8 1.1.8 1.9 0 2.6-1.8 3.1-3.6 3.3.3.2.6.7.6 1.4v2.1c3.5-1 6-3.6 6-6.8 0-4-4-7.2-9-7.2z"
                        fill="#ffffff"
                      />
                    )}
                    {tool.glyph === 'aws' && (
                      <text
                        x="40"
                        y="37"
                        text-anchor="middle"
                        fill="#ffffff"
                        font-family="Oswald, sans-serif"
                        font-size="11"
                        font-weight="700"
                      >
                        AWS
                      </text>
                    )}
                    {tool.glyph === 'docker' && (
                      <g fill="#ffffff">
                        <rect x="31" y="33" width="4" height="3.5" />
                        <rect x="36" y="33" width="4" height="3.5" />
                        <rect x="41" y="33" width="4" height="3.5" />
                        <rect x="36" y="29" width="4" height="3.5" />
                        <path d="M29 37.5h21c-1 3.5-4.5 5-10.5 5s-9.5-1.5-10.5-5z" />
                      </g>
                    )}
                    {tool.glyph === 'postgres' && (
                      <text
                        x="40"
                        y="37"
                        text-anchor="middle"
                        fill="#ffffff"
                        font-family="Oswald, sans-serif"
                        font-size="11"
                        font-weight="700"
                      >
                        SQL
                      </text>
                    )}
                    {tool.glyph === 'ts' && (
                      <text
                        x="40"
                        y="37"
                        text-anchor="middle"
                        fill="#ffffff"
                        font-family="Oswald, sans-serif"
                        font-size="11.5"
                        font-weight="700"
                      >
                        TS
                      </text>
                    )}
                    {tool.glyph === 'nextjs' && (
                      <text
                        x="40"
                        y="37"
                        text-anchor="middle"
                        fill="#ffffff"
                        font-family="Oswald, sans-serif"
                        font-size="10.5"
                        font-weight="700"
                      >
                        NEXT
                      </text>
                    )}
                    {tool.glyph === 'firebase' && (
                      <polygon
                        points="34,40 37,26 41,33 44,28 47,40 40,43"
                        fill="#ffffff"
                      />
                    )}
                    {tool.glyph === 'redis' && (
                      <polygon points="40,27 50,32 40,37 30,32" fill="#ffffff" />
                    )}
                    {tool.glyph === 'linux' && (
                      <text
                        x="40"
                        y="37"
                        text-anchor="middle"
                        fill="#ffffff"
                        font-family="Oswald, sans-serif"
                        font-size="10.5"
                        font-weight="700"
                      >
                        LNX
                      </text>
                    )}
                    {tool.glyph === 'cicd' && (
                      <text
                        x="40"
                        y="37"
                        text-anchor="middle"
                        fill="#ffffff"
                        font-family="Oswald, sans-serif"
                        font-size="10"
                        font-weight="700"
                      >
                        CI/CD
                      </text>
                    )}
                    {tool.glyph === 'kotlin' && (
                      <polygon points="33,28 47,28 40,34 47,40 33,40" fill="#ffffff" />
                    )}
                  </g>
                </svg>
              </div>

              <div class="iso-tooltip" role="tooltip">
                  <div class="text-xs font-semibold tracking-tight">{tool.name}</div>
                  <div class="text-[10px] font-mono text-zinc-300">{statusLabel}</div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
